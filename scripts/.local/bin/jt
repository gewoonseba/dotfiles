#!/usr/bin/env bash
# Re-exec under bash 4+ if needed. macOS ships bash 3.2, which lacks associative
# arrays (declare -A); this script relies on them (e.g. _wt_collect's PR maps).
# Homebrew installs a modern bash at one of the paths below.
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
    for _b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
        [ -x "$_b" ] && exec "$_b" "$0" "$@"
    done
    echo "jt: requires bash 4+ (macOS ships 3.2). Install with: brew install bash" >&2
    exit 1
fi
set -euo pipefail

# jt — Jolteon worktree & service manager
# See: jt help

# Base work dir — tolerate Work/work casing across machines, preferring "Work".
#
# The order matters and used to be the other way round. On a case-INSENSITIVE
# filesystem (macOS) either spelling resolves the same directory, so the preference is
# invisible there. On a case-SENSITIVE one both can exist as separate directories, each
# a full clone with its own worktrees and its own .env files — and then whichever this
# picks is silently the only repo jt can see. That is not hypothetical: this box has
# both, and preferring lowercase meant `jt setup` copied env files from the checkout
# that was NOT being maintained, handing every new worktree a stale .env (a missing
# CUSTOMER_DATA_STORAGE_CONNECTION_STRING, so invoice intake 500s).
#
# "Work" is canonical: it holds the current .env files. If you ever migrate to the
# lowercase one, move the env files with it rather than flipping this back.
WORK="$HOME/Work"; [ -d "$WORK" ] || WORK="$HOME/work"
REPO="$WORK/jolteon"
# All worktrees live flat under ~/work/worktrees/<repo>/<worktree-name>, with a
# slash-free worktree name (a branch's '/' becomes '-' — see wt_dir). Keeping
# them one level deep, not nested by branch prefix, means the on-disk name is
# always a single directory that mirrors the branch.
WORKTREES="$WORK/worktrees/jolteon"

# Config for the local LiteLLM gateway started with the --agent stack. Kept beside
# environments.sh rather than in the repo: it is machine setup, not project code.
LITELLM_CONFIG="$HOME/.config/jt/litellm/config.yaml"

# Prefer system-installed Python (e.g. Homebrew) over uv-managed downloads
export UV_PYTHON_PREFERENCE=system

# ─── Helpers ───────────────────────────────────────────────

hint_worktree() {
    echo ""
    echo "Hint: make sure you're in a Jolteon worktree (see 'jt worktree list')."
}

# Resolve the on-disk worktree directory for a branch. Worktree names are
# slash-free, so a branch like 'feat/foo' maps to '<WORKTREES>/feat-foo'.
wt_dir() {
    printf '%s/%s' "$WORKTREES" "${1//\//-}"
}

# When create/checkout finds an existing worktree, offer to enter it instead.
# Keep non-interactive callers fail-fast rather than silently changing cwd.
open_existing_worktree_or_exit() {
    local branch="$1"
    local worktree_dir="$2"
    local answer

    echo "Worktree already exists at: $worktree_dir"
    if [ ! -t 0 ]; then
        echo "Use 'jt worktree open $branch' to cd into it, or 'jt worktree edit $branch' to open in Zed."
        exit 1
    fi

    while true; do
        read -rp "Open the existing worktree? [Y/n] " answer || exit 1
        case "${answer,,}" in
            ""|y|yes) cmd_worktree_open "$branch" ;;
            n|no)     echo "Not opening the existing worktree."; exit 0 ;;
            *)        echo "Please answer yes or no." ;;
        esac
    done
}

# Switch to the node version the repo pins in .nvmrc, installing it via nvm if
# missing. The pin is not cosmetic: node 26 ships npm 12, which refuses
# remote-tarball dependencies by default, and services/frontend installs 'xlsx'
# from the SheetJS CDN — so 'npm i' dies with EALLOWREMOTE when a newer system
# node (e.g. a distro package) shadows the pin. Doing it here keeps every
# npm/node call below (install, vite dev, sdk build) on the same version as
# .nvmrc and CI, in the non-interactive shells where the zshrc setup never runs.
use_pinned_node() {
    local dir="${1:-$REPO}" version nvm_sh
    [ -f "$dir/.nvmrc" ] || dir="$REPO"
    [ -f "$dir/.nvmrc" ] || return 0
    # Pure-bash trim: avoids the BSD/GNU 'tr' escape differences that a
    # 'tr -d' pipeline would hit between macOS and Linux. Handles a bare
    # "24.13" and a "v24.13" alike.
    # '|| true': read reports failure on a final line with no trailing newline,
    # having still assigned it — the emptiness check below is the real guard.
    read -r version < "$dir/.nvmrc" || true
    version="${version//[[:space:]]/}"; version="${version#v}"
    [ -n "$version" ] || return 0

    # Two distinct things, deliberately tracked apart: where nvm keeps installed
    # versions (NVM_DIR) and where nvm.sh itself lives. 'brew install nvm' puts
    # nvm.sh under the Homebrew prefix while versions still belong in NVM_DIR, so
    # collapsing the two would have nvm install node into the Cellar.
    local data_dir="${NVM_DIR:-}"
    if [ -z "$data_dir" ]; then
        # Match the zshrc's XDG location, falling back to nvm's own default.
        data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/nvm"
        [ -d "$data_dir" ] || [ ! -d "$HOME/.nvm" ] || data_dir="$HOME/.nvm"
    fi

    nvm_sh=""
    local c
    for c in "$data_dir" "${XDG_DATA_HOME:-$HOME/.local/share}/nvm" "$HOME/.nvm" \
             /opt/homebrew/opt/nvm /usr/local/opt/nvm; do
        [ -s "$c/nvm.sh" ] && { nvm_sh="$c/nvm.sh"; break; }
    done
    if [ -z "$nvm_sh" ]; then
        echo "Warning: nvm not found — using node $(node -v 2>/dev/null || echo '?')," >&2
        echo "but this repo pins node $version. Expect 'npm i' to fail if they differ." >&2
        return 0
    fi
    export NVM_DIR="$data_dir"
    [ -d "$NVM_DIR" ] || mkdir -p "$NVM_DIR"

    # nvm.sh reads unset variables and returns non-zero on benign paths, so it
    # is not safe under this script's 'set -euo pipefail'. Relax around it only.
    # --no-use keeps sourcing cheap: we pick the version explicitly next.
    set +eu
    # shellcheck disable=SC1090
    . "$nvm_sh" --no-use >/dev/null 2>&1
    nvm use "$version" >/dev/null 2>&1 || {
        echo "Installing node $version (pinned in .nvmrc)..."
        nvm install "$version" >/dev/null 2>&1
        nvm use "$version" >/dev/null 2>&1
    }
    set -eu

    # 'nvm use' mutates PATH in this shell; confirm it took rather than trusting
    # it, so a failed install surfaces here instead of as a confusing npm error.
    local active
    active="$(node -v 2>/dev/null || true)"
    case "$active" in
        "v$version"|"v$version".*) ;;
        *) echo "Warning: wanted node $version (.nvmrc) but node is ${active:-absent}." >&2 ;;
    esac
}

# Echo a usable current directory, or fail with guidance. A shell whose cwd was
# moved or removed out from under it (e.g. after a worktree was relocated or
# removed) keeps a stale $PWD that no longer exists, which otherwise turns into
# a confusing "getcwd"/"no pyproject.toml" cascade in the commands below.
cwd_or_die() {
    local d
    d="$(pwd -L 2>/dev/null || true)"
    if [ -z "$d" ] || [ ! -d "$d" ]; then
        echo "Error: the current directory is unavailable — it was likely moved or removed" >&2
        echo "(e.g. after a worktree was relocated). Re-enter it in a fresh shell:" >&2
        echo "  cd $WORKTREES/<name>" >&2
        echo "…or pass the target explicitly instead of relying on the current directory." >&2
        return 1
    fi
    printf '%s\n' "$d"
}

# Interactive one-of picker over lines read from stdin. Uses fzf when present,
# otherwise a numbered menu. Echoes the chosen raw line on stdout; the UI and
# prompts go to the tty/stderr so callers can capture the result via $(...).
# Returns non-zero if there's nothing to pick or the user aborts.
pick_line() {
    local prompt="${1:-pick> }" input
    input="$(cat)"
    [ -z "$input" ] && { echo "Nothing to pick." >&2; return 1; }

    if command -v fzf >/dev/null 2>&1; then
        printf '%s\n' "$input" | fzf --prompt="$prompt" --height=40% --reverse --with-nth=1.. --delimiter=$'\t'
        return
    fi

    # Numbered fallback. Menu to stderr; read from the tty (stdin is the pipe).
    local -a rows=(); local line i=1
    while IFS= read -r line; do
        printf "  %2d) %s\n" "$i" "${line//$'\t'/  }" >&2
        rows+=("$line"); i=$((i+1))
    done <<< "$input"
    local choice
    read -rp "$prompt[1-${#rows[@]}]: " choice </dev/tty || return 1
    [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#rows[@]}" ] \
        || { echo "Invalid choice." >&2; return 1; }
    printf '%s\n' "${rows[$((choice-1))]}"
}

# Emit "branch<TAB>dir" for each worktree with a checked-out branch. Pass
# "managed" to restrict to jt worktrees under $WORKTREES (skips the main
# checkout and other tools' trees). Detached worktrees have no branch and are
# omitted (nothing to key remove/nuke on).
worktrees_tsv() {
    local managed="${1:-}"
    git -C "$REPO" worktree list --porcelain 2>/dev/null | awk -v managed="$managed" -v wt="$WORKTREES/" '
        /^worktree / { d=substr($0, 10) }
        /^branch /   { b=$2; sub("refs/heads/", "", b);
                       if (managed == "" || substr(d, 1, length(wt)) == wt) printf "%s\t%s\n", b, d }
    '
}

trap 'hint_worktree' ERR

# Fast bits (~1s): env files + CLAUDE.md + .claude/.cursor/.vscode +
# .compound-engineering. These must exist before an AI agent starts so it
# sees the full worktree.
setup_worktree_fast() {
    local target_dir="$1"

    echo "Copying environment files..."
    # .claude and .emdash hold other tools' worktrees. Walking them copies every
    # worktree's .env into this one — and into itself when the target is one of
    # them, so each run nests the copies a level deeper.
    (cd "$REPO" && find . \( -name node_modules -o -name .venv -o -name .git -o -name .data -o -name .emdash -o -name .claude \) -prune -o -name '.env' -print) | while read -r envfile; do
        if [ -f "$REPO/$envfile" ]; then
            mkdir -p "$target_dir/$(dirname "$envfile")"
            cp "$REPO/$envfile" "$target_dir/$envfile"
        fi
    done

    if [ -f "$REPO/CLAUDE.md" ]; then
        cp "$REPO/CLAUDE.md" "$target_dir/CLAUDE.md"
        echo "  copied CLAUDE.md"
    fi

    # .compound-engineering is fully gitignored (machine-local CE config), so it
    # won't arrive in a worktree created from origin/main — copy it across like
    # .claude so CE behaves the same in every worktree.
    local d
    for d in .claude .cursor .vscode .compound-engineering; do
        if [ -d "$REPO/$d" ] && [ ! -d "$target_dir/$d" ]; then
            rsync -a --exclude=/worktrees/ "$REPO/$d/" "$target_dir/$d/"
            echo "  copied $d/"
        fi
    done
}

# Slow bits (tens of seconds to minutes): backgrounded with output to a log.
setup_worktree_deps() {
    local target_dir="$1"

    echo "Installing Python dependencies..."
    (cd "$target_dir" && uv sync --quiet)

    echo "Installing frontend dependencies..."
    # Not silenced: npm's failures here (version pin, registry auth, lockfile
    # drift) are the ones worth reading in .jt-setup.log, and discarding stderr
    # turned a clear EALLOWREMOTE into an unexplained non-zero exit.
    use_pinned_node "$target_dir"
    (cd "$target_dir/services/frontend" && npm i --no-fund --no-audit)

    echo "Installing pre-commit hooks..."
    (cd "$target_dir" && uv run pre-commit install)
}

# Full setup (used by 'jt worktree setup' where the user wants blocking output).
setup_worktree() {
    setup_worktree_fast "$1"
    setup_worktree_deps "$1"
}

# Launch an agent, optionally seeding it with an initial prompt. claude and
# codex take the prompt as a positional arg; agy needs -i (--prompt-interactive).
exec_agent() {
    local agent="$1" prompt="${2:-}"
    if [ -z "$prompt" ]; then
        exec "$agent"
    fi
    case "$agent" in
        agy) exec "$agent" -i "$prompt" ;;
        *)   exec "$agent" "$prompt" ;;
    esac
}

# Locate the Zed binary — 'zed' on most installs, 'zeditor' on some Linux
# packages. Echoes the resolved path; returns non-zero if neither is present.
find_zed() {
    command -v zed 2>/dev/null || command -v zeditor 2>/dev/null
}

post_create_worktree() {
    local worktree_dir="$1"
    local preamble="${2:-}"
    local log_file="$worktree_dir/.jt-setup.log"

    # Fast bits synchronously so the agent sees CLAUDE.md / .claude/ on boot.
    setup_worktree_fast "$worktree_dir"

    # Slow bits in background, output to log.
    (setup_worktree_deps "$worktree_dir" >"$log_file" 2>&1) &
    disown 2>/dev/null || true

    # Always tell the wrapper where to cd, even if user aborts the prompt.
    if [ -n "${JT_CD_FILE:-}" ]; then
        printf '%s\n' "$worktree_dir" > "$JT_CD_FILE"
    fi

    echo ""
    echo "Worktree ready at: $worktree_dir"
    echo "Dependencies installing in background (log: $log_file)"
    echo ""
    echo "Open the worktree in?"
    echo "  1) claude"
    echo "  2) codex"
    echo "  3) agy"
    echo "  4) zed"
    echo "  5) none"
    read -rp "Choice [5]: " choice

    local agent="" open_zed=0
    case "${choice:-5}" in
        1|claude) agent="claude" ;;
        2|codex)  agent="codex" ;;
        3|agy)    agent="agy" ;;
        4|zed)    open_zed=1 ;;
    esac

    # Zed is a GUI editor that returns immediately, so launch it here (detached)
    # and let the cd still happen — you end up with the IDE open AND your shell in
    # the worktree. Agents, by contrast, take over the terminal via the wrapper.
    if [ "$open_zed" -eq 1 ]; then
        local zed_cmd
        if zed_cmd="$(find_zed)"; then
            ("$zed_cmd" "$worktree_dir" >/dev/null 2>&1 &)
            echo "Opening worktree in Zed..."
        else
            echo "zed/zeditor not found — skipping IDE launch."
        fi
    fi

    # Wrapper path: hand the agent (and any preamble) to the zsh function so it
    # runs in the user's real shell (after the cd). The wrapper handles the
    # "not found" case.
    if [ -n "${JT_AGENT_FILE:-}" ]; then
        if [ -n "$agent" ]; then
            printf '%s\n' "$agent" > "$JT_AGENT_FILE"
            [ -n "$preamble" ] && [ -n "${JT_PROMPT_FILE:-}" ] && printf '%s' "$preamble" > "$JT_PROMPT_FILE"
        fi
        exit 0
    fi

    # Fallback for when jt is invoked without the zsh wrapper: best-effort
    # cd + exec inside this process.
    cd "$worktree_dir"
    if [ -n "$agent" ]; then
        command -v "$agent" >/dev/null 2>&1 || { echo "$agent not found."; exit 0; }
        exec_agent "$agent" "$preamble"
    fi
    exit 0
}

# Parse --local/--dev/--fork/--prd-fork/--prd flags into $ENV_CHOICE. Unknown args go to
# $REMAINING_ARGS.
#
# The environments, each signed into with your real dev account (except prd-fork):
#   local     seeded databases on this machine (`jt db seed`) — dev's identities, disposable
#   dev       the day-to-day writable one
#   fork      a Tiger fork of DEV — take one when your change involves a migration
#   prd-fork  a Tiger fork of PRD — real customer data, writable, auto-deleted. The one way to
#             see production data locally; entered with a persona (--as) for now.
#   prd       read-only prd — left only for `jt mcp run`; `jt app run` refuses it
parse_env_flag() {
    ENV_CHOICE=""
    PERSONA=""
    REMAINING_ARGS=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --local|--lcl) ENV_CHOICE="local"; shift ;;
            --dev)  ENV_CHOICE="dev"; shift ;;
            --fork) ENV_CHOICE="fork"; shift ;;
            # Underscored, not hyphenated: the value is interpolated into function names
            # (env_$env, agent_env_$env) and the persona case, and a hyphen is not valid
            # in a shell identifier.
            --prd-fork|--prdfork) ENV_CHOICE="prd_fork"; shift ;;
            --prd)  ENV_CHOICE="prd"; shift ;;
            --as)
                # --as <persona>; a bare --as (or one followed by another flag)
                # defaults to root.
                if [ -n "${2:-}" ] && [ "${2#--}" = "$2" ]; then
                    PERSONA="$2"; shift 2
                else
                    PERSONA="root"; shift
                fi
                ;;
            *)     REMAINING_ARGS+=("$1"); shift ;;
        esac
    done
}

# ─── Tiger forks ───────────────────────────────────────────
#
# `--fork` and `--prd-fork` resolve their connection details from the Tiger CLI at launch
# instead of from environments.sh, and that is the whole design rather than a convenience.
#
# A fork's endpoint does not follow the convention the other environments use: it is the
# PUBLIC host (`*.db.*`, not `*.privatelink.*`) on a port Tiger assigns per service, so
# BOTH change every time you take one. Typing them is how you get a password-auth failure
# against the right host and spend twenty minutes on the wrong suspect.
#
# So the only thing written down is the pair of service ids (in $JT_FORK_DIR, written by
# `jt fork create`). Host, port, role and password come from `tiger db connection-string
# --with-password`, which reads the password out of the CLI's own store — `~/.pgpass`.
# Nothing secret goes in a file anybody edits, and nothing is copied by hand.
#
# Forks come in PAIRS from the same environment, and that is not a convention either.
# Jolteon holds the customer data; agent-service holds conversations AND its own copy of
# orgs, users and memberships, and it gates every request on that copy — so a prd Jolteon
# fork beside the dev agent database resolves none of the prd org ids and refuses every
# conversation. One command takes both so the two cannot drift apart.
#
# Note on `set -e`: nearly every helper here inspects a command's OUTPUT and decides what
# to do about an empty one, so the substitutions carry `|| true`. Without it a Tiger call
# that exits non-zero kills jt at the assignment and the careful error message below it
# never prints.
JT_FORK_DIR="$HOME/.config/jt/forks"

# Which upstream service each half of a pair is forked from, by NAME rather than by id.
# `tiger service list` resolves the name, which is the same lookup tiger_fork.yaml does —
# so a service re-created with a new id does not strand this table.
fork_source_name() {
    case "$1:$2" in
        dev:jolteon) echo "jolteon_dev" ;;
        dev:agent)   echo "agent_service_dev" ;;
        prd:jolteon) echo "jolteon_prd" ;;
        prd:agent)   echo "agent_service_prd" ;;
        *)           return 1 ;;
    esac
}

fork_config_path() { echo "$JT_FORK_DIR/$1"; }

# The jt flag that selects an env's fork pair — "--fork" for dev, "--prd-fork" for prd.
fork_flag() { [ "$1" = "dev" ] && echo "--fork" || echo "--prd-fork"; }

# Tiger API credentials, from Key Vault — the same two secrets the fork workflow reads.
# Fetched rather than kept on disk, and only when a fork env is actually selected.
fork_tiger_auth() {
    [ -n "${TIGER_PUBLIC_KEY:-}" ] && [ -n "${TIGER_SECRET_KEY:-}" ] && return 0
    command -v az >/dev/null 2>&1 || { echo "Error: az CLI not found; cannot read Tiger credentials." >&2; return 1; }
    TIGER_PUBLIC_KEY="$(az keyvault secret show --vault-name kv-companionenergy-weu --name TigerPublicKey --query value -o tsv 2>/dev/null || true)"
    TIGER_SECRET_KEY="$(az keyvault secret show --vault-name kv-companionenergy-weu --name TigerSecretKey --query value -o tsv 2>/dev/null || true)"
    export TIGER_PUBLIC_KEY TIGER_SECRET_KEY
    if [ -z "$TIGER_PUBLIC_KEY" ] || [ -z "$TIGER_SECRET_KEY" ]; then
        echo "Error: could not read Tiger credentials from Key Vault. Is 'az login' current?" >&2
        return 1
    fi
    return 0
}

# Everything a fork command needs before it can talk to Tiger.
fork_preflight() {
    command -v tiger >/dev/null 2>&1 || { echo "Error: tiger CLI not found (https://cli.tigerdata.com)." >&2; return 1; }
    command -v jq >/dev/null 2>&1 || { echo "Error: jq not found." >&2; return 1; }
    fork_tiger_auth || return 1
}

# Every tiger read goes through here: the version check would otherwise stall the first
# call of the day on a network round-trip, and JSON is the only output shape worth parsing.
# Auth is the caller's job, since most helpers make more than one call.
fork_tiger() {
    TIGER_VERSION_CHECK_INTERVAL=0 TIGER_OUTPUT=json tiger "$@" 2>/dev/null || true
}

# The service id behind a name, or empty. `head -1` because a duplicate name would
# otherwise return two ids on two lines and every later command would see one string.
fork_resolve_source() {
    fork_tiger service list | jq -r --arg n "$1" '.[] | select(.name == $n) | .service_id' 2>/dev/null | head -1 || true
}

# READY / PAUSED / QUEUED / …, or empty when no such service exists — which is the normal
# state of a fork whose duration ran out, since the cleanup workflow really deletes it.
fork_service_status() {
    [ -n "${1:-}" ] || return 0
    fork_tiger service get "$1" | jq -r '.status // empty' 2>/dev/null || true
}

# Export <prefix>HOST/PORT/USER/PASSWORD/DATABASE/SSLMODE for one Tiger service.
# `prefix` is "PG_" for Jolteon or "AGENT_PG_" for agent-service — the two naming schemes
# jt already passes to the services.
fork_export_service() {
    local id="$1" prefix="$2" cs
    fork_tiger_auth || return 1
    cs="$(TIGER_VERSION_CHECK_INTERVAL=0 TIGER_OUTPUT=text \
            tiger db connection-string "$id" --with-password --password-storage pgpass 2>/dev/null || true)"
    if [ -z "$cs" ]; then
        echo "Error: no connection string for Tiger service '$id'." >&2
        echo "       Is the fork still alive ('jt fork status'), and has its password" >&2
        echo "       been stored ('tiger db save-password $id --password-storage pgpass')?" >&2
        return 1
    fi
    # postgresql://USER:PASSWORD@HOST:PORT/DB?... — parsed with bash rather than a URL
    # library because the password must not become an argv entry anywhere.
    local rest userinfo hostport
    rest="${cs#*://}"; rest="${rest%%\?*}"
    userinfo="${rest%%@*}"; hostport="${rest#*@}"
    local user pass host port db
    user="${userinfo%%:*}"; pass="${userinfo#*:}"
    db="${hostport#*/}"; hostport="${hostport%%/*}"
    host="${hostport%:*}"; port="${hostport##*:}"
    if [ -z "$pass" ] || [ "$pass" = "$userinfo" ]; then
        echo "Error: connection string for '$id' carries no password." >&2
        echo "       Store it once: tiger db save-password $id --password-storage pgpass" >&2
        return 1
    fi
    export "${prefix}HOST=$host" "${prefix}PORT=$port" "${prefix}USER=$user" \
           "${prefix}PASSWORD=$pass" "${prefix}DATABASE=$db" "${prefix}SSLMODE=require"
    return 0
}

# Whether ~/.pgpass already holds this service's password, judged the way jt will read it
# back: ask for a connection string and see whether the userinfo carries a colon. Checked
# rather than assumed because re-fetching from Key Vault fails on a fork whose secret has
# expired even when the fork itself is perfectly alive.
fork_password_stored() {
    local cs userinfo
    cs="$(TIGER_VERSION_CHECK_INTERVAL=0 TIGER_OUTPUT=text \
            tiger db connection-string "$1" --with-password --password-storage pgpass 2>/dev/null || true)"
    [ -n "$cs" ] || return 1
    userinfo="${cs#*://}"; userinfo="${userinfo%%@*}"
    case "$userinfo" in *:*) return 0 ;; *) return 1 ;; esac
}

# Store one fork's password in ~/.pgpass. Through TIGER_NEW_PASSWORD, never --password: an
# argv entry is readable in `ps` by every process on the machine for as long as it runs.
fork_save_password() {
    TIGER_NEW_PASSWORD="$2" TIGER_VERSION_CHECK_INTERVAL=0 \
        tiger db save-password "$1" --password-storage pgpass >/dev/null 2>&1
}

# Read a pair's ids out of its config into JOLTEON_FORK_ID / AGENT_FORK_ID.
# Unset first: this is sourced more than once per run, and a stale id surviving from the
# previous read is exactly the bug this file exists to stop — it would connect happily to
# whatever that id still points at.
fork_load_config() {
    local cfg; cfg="$(fork_config_path "$1")"
    unset JOLTEON_FORK_ID AGENT_FORK_ID
    [ -f "$cfg" ] || return 1
    # shellcheck source=/dev/null
    source "$cfg"
    [ -n "${JOLTEON_FORK_ID:-}" ] && [ -n "${AGENT_FORK_ID:-}" ]
}

# Both halves present and both still answering. Deliberately not "READY": a PAUSED fork is
# still a fork and Tiger resumes it on connect, so refusing one would send you off to take
# a fresh pair for no reason.
fork_pair_alive() {
    [ -n "${1:-}" ] && [ -n "${2:-}" ] || return 1
    [ -n "$(fork_service_status "$1")" ] && [ -n "$(fork_service_status "$2")" ]
}

# The GitHub login, which is what the fork NAME has to carry — see fork_name.
fork_actor() {
    command -v gh >/dev/null 2>&1 || { echo "Error: gh CLI not found; cannot resolve your GitHub login." >&2; return 1; }
    local login; login="$(gh api user --jq .login 2>/dev/null || true)"
    [ -n "$login" ] || { echo "Error: could not read your GitHub login. Try 'gh auth login'." >&2; return 1; }
    echo "$login"
}

# `{project}-{env}-fork-{actor}-{duration}`, and every part of it is load-bearing for the
# CLEANUP side rather than for us: tiger_fork_cleanup.yaml runs hourly, selects services
# matching /-fork-.+-(3h|6h|9h)$/, reads the duration off the end of the name and deletes
# the fork once created+duration has passed. A fork named anything else is never collected
# and quietly bills until somebody notices — so this has to keep matching tiger_fork.yaml.
fork_name() {
    echo "${1}-${2}-fork-${3}-${4}"
}

# Take one fork and store its password. Echoes the new service id on stdout; everything
# else goes to stderr, so the caller can capture the id alone.
fork_create_one() {
    local source_name="$1" project="$2" env="$3" actor="$4" duration="$5"
    local src; src="$(fork_resolve_source "$source_name")"
    if [ -z "$src" ]; then
        echo "Error: no Tiger service named '$source_name' to fork from." >&2
        return 1
    fi
    local name; name="$(fork_name "$project" "$env" "$actor" "$duration")"
    echo "  $source_name ($src)" >&2
    echo "  → $name" >&2

    # --last-snapshot: minutes rather than a fresh snapshot of a production-sized database,
    #   and a snapshot a few hours old is what a fork is for anyway.
    # --no-wait: both halves are kicked off before either is waited on, so the two come up
    #   in parallel instead of one after the other.
    # --no-set-default: forking otherwise makes the fork your default tiger service, which
    #   then dangles at every bare `tiger db …` once the cleanup job deletes it.
    # stderr is kept SEPARATE, not folded in with 2>&1: `tiger service fork` narrates its
    # progress ("🍴 Forking service…") on stderr and prints the JSON on stdout, so merging
    # the two hands jq a document with prose in front of it and every parse below fails —
    # after the fork has already been created and started billing.
    local result stderr_file; stderr_file="$(mktemp)"
    result="$(TIGER_VERSION_CHECK_INTERVAL=0 TIGER_OUTPUT=json \
                tiger service fork "$src" --last-snapshot --with-password --no-wait \
                --no-set-default --name "$name" 2>"$stderr_file" || true)"
    # From the first brace on, in case a future CLI version narrates on stdout after all.
    result="$(sed -n '/^[[:space:]]*{/,$p' <<<"$result")"
    local id; id="$(jq -r '.service_id // empty' <<<"$result" 2>/dev/null || true)"
    if [ -z "$id" ]; then
        # Only stderr, never $result: the response body carries the new password in the
        # clear, and an error path is exactly where it would get pasted into a bug report.
        echo "Error: fork of '$source_name' failed:" >&2
        sed 's/^/       /' "$stderr_file" >&2
        rm -f "$stderr_file"
        return 1
    fi
    rm -f "$stderr_file"

    local pass; pass="$(jq -r '.password // empty' <<<"$result" 2>/dev/null || true)"
    if [ -z "$pass" ]; then
        echo "Error: fork '$id' came back without a password, so jt cannot connect to it." >&2
        return 1
    fi
    if ! fork_save_password "$id" "$pass"; then
        echo "Error: could not save the password for '$id' to ~/.pgpass." >&2
        return 1
    fi
    echo "$id"
}

# Block until a service leaves QUEUED/CONFIGURING. A fork is not connectable the moment
# the API hands back an id, and what that causes downstream is a password-auth failure
# against a host that does exist — the most misleading symptom in this whole path.
fork_wait_ready() {
    local id="$1" label="$2" waited=0 status
    while [ "$waited" -lt 900 ]; do
        status="$(fork_service_status "$id")"
        case "$status" in
            READY|PAUSED) echo "  $label ready after ${waited}s ($id)" >&2; return 0 ;;
            "")           echo "Error: $label ($id) vanished while coming up." >&2; return 1 ;;
        esac
        sleep 10; waited=$((waited + 10))
        [ $((waited % 60)) -eq 0 ] && echo "  $label still ${status:-?} … ${waited}s" >&2
    done
    echo "Error: $label ($id) still not ready after 15m. Check 'jt fork status'." >&2
    return 1
}

fork_write_config() {
    local env="$1" jolteon_id="$2" agent_id="$3" cfg flag taken
    cfg="$(fork_config_path "$env")"
    flag="$(fork_flag "$env")"
    taken="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
    mkdir -p "$JT_FORK_DIR"
    cat > "$cfg" <<EOF
# Which Tiger forks 'jt app run $flag' should use. Written by 'jt fork create'.
#
# IDS ONLY — no hosts, no ports, no passwords. jt asks the Tiger CLI for those at launch
# ('tiger db connection-string <id> --with-password'), because a fork's host AND port both
# change per fork, and the password lives in ~/.pgpass rather than in a file you edit.
#
# Both ids are required, and from the SAME environment: agent-service keeps its own copy of
# orgs, users and memberships and gates every request on it, so a $env jolteon fork beside
# another environment's agent database resolves no org and refuses every conversation.
#
# Taken $taken. Forks are deleted automatically once their duration expires;
# 'jt fork status' says how long is left, 'jt fork create --$env' takes a fresh pair.

# Fork of ${env}'s jolteon database — customer data, and the invoice rows the worker writes.
JOLTEON_FORK_ID=$jolteon_id

# Fork of ${env}'s agent_service database — conversations, personas, model catalog, identity mirror.
AGENT_FORK_ID=$agent_id
EOF
    echo "  ids written to $cfg" >&2
}

# ─── Fork commands ─────────────────────────────────────────

cmd_fork_create() {
    local env="prd" duration="6h"
    while [ $# -gt 0 ]; do
        case "$1" in
            --prd) env="prd"; shift ;;
            --dev) env="dev"; shift ;;
            --duration) duration="${2:-6h}"; shift 2 ;;
            *) echo "Usage: jt fork create [--prd|--dev] [--duration 3h|6h|9h]" >&2; return 1 ;;
        esac
    done
    # Only these three, because the cleanup workflow reads the duration off the fork's name
    # and understands exactly this set. Anything else names a fork it will not collect.
    case "$duration" in
        3h|6h|9h) ;;
        *) echo "Error: --duration must be 3h, 6h or 9h (the cleanup job knows no others)." >&2; return 1 ;;
    esac

    fork_preflight || return 1
    local actor; actor="$(fork_actor)" || return 1

    # A live pair already recorded is almost always the answer, since a fork takes minutes
    # to come up and bills for its whole duration. Say so and let the caller insist.
    if fork_load_config "$env" && fork_pair_alive "$JOLTEON_FORK_ID" "$AGENT_FORK_ID"; then
        echo "A live $env fork pair is already recorded:"
        echo "  jolteon: $JOLTEON_FORK_ID"
        echo "  agent:   $AGENT_FORK_ID"
        local reply=""
        read -rp "Take a fresh pair anyway? [y/N]: " reply || true
        case "${reply:-n}" in [Yy]*) ;; *) echo "Keeping the existing pair."; return 0 ;; esac
    fi

    echo "Taking a $env fork pair ($duration, as $actor):"
    local jolteon_id agent_id
    jolteon_id="$(fork_create_one "$(fork_source_name "$env" jolteon)" jolteon "$env" "$actor" "$duration")" || return 1
    if ! agent_id="$(fork_create_one "$(fork_source_name "$env" agent)" agent_service "$env" "$actor" "$duration")"; then
        # Half a pair is worse than none: it bills for the full duration and jt refuses to
        # start on it anyway. Name the orphan rather than leaving it to be discovered.
        echo "" >&2
        echo "The jolteon half ($jolteon_id) was created but the agent half failed." >&2
        echo "Delete the orphan so it does not bill for $duration:" >&2
        echo "  tiger service delete $jolteon_id --confirm" >&2
        return 1
    fi

    echo ""
    echo "Waiting for both (usually 2-5m on --last-snapshot):"
    fork_wait_ready "$jolteon_id" "jolteon" || return 1
    fork_wait_ready "$agent_id" "agent" || return 1

    echo ""
    fork_write_config "$env" "$jolteon_id" "$agent_id"
    echo "  passwords stored in ~/.pgpass"
    echo ""
    echo "Deleted automatically after $duration. Now:"
    if [ "$env" = "prd" ]; then
        echo "  jt app run --prd-fork --as root --agent"
    else
        echo "  jt app run --fork --agent"
    fi
}

cmd_fork_status() {
    fork_preflight || return 1
    local env
    for env in dev prd; do
        echo "$env  ($(fork_config_path "$env")):"
        if ! fork_load_config "$env"; then
            echo "  no pair recorded — 'jt fork create --$env'"
            echo ""
            continue
        fi
        local half
        for half in "jolteon:$JOLTEON_FORK_ID" "agent:$AGENT_FORK_ID"; do
            local label="${half%%:*}" id="${half#*:}" json status name created
            json="$(fork_tiger service get "$id")"
            status="$(jq -r '.status // empty' <<<"$json" 2>/dev/null || true)"
            if [ -z "$status" ]; then
                printf '  %-8s %-12s GONE (expired and cleaned up)\n' "$label" "$id"
                continue
            fi
            name="$(jq -r '.name // empty' <<<"$json" 2>/dev/null || true)"
            created="$(jq -r '.created // empty' <<<"$json" 2>/dev/null || true)"
            printf '  %-8s %-12s %-10s %-18s %s\n' \
                "$label" "$id" "$status" "$(fork_remaining "$name" "$created")" "$name"
        done
        echo ""
    done
}

# How long a fork has left, computed the same way tiger_fork_cleanup.yaml computes it: the
# duration is carried in the NAME, not by the API, so name plus created is the only source.
fork_remaining() {
    local name="$1" created="$2" ttl created_epoch left
    case "$name" in
        *-3h) ttl=10800 ;; *-6h) ttl=21600 ;; *-9h) ttl=32400 ;;
        # No duration suffix means the cleanup job's regex does not match it either, so it
        # is somebody's hand-made fork and nothing will collect it.
        *) echo "no expiry (uncollected)"; return 0 ;;
    esac
    created_epoch="$(date -d "$created" +%s 2>/dev/null || true)"
    [ -n "$created_epoch" ] || { echo "?"; return 0; }
    left=$(( created_epoch + ttl - $(date +%s) ))
    if [ "$left" -gt 0 ]; then
        echo "$((left / 3600))h$(( (left % 3600) / 60 ))m left"
    else
        echo "overdue for cleanup"
    fi
}

cmd_fork_delete() {
    local env="prd"
    while [ $# -gt 0 ]; do
        case "$1" in
            --prd) env="prd"; shift ;;
            --dev) env="dev"; shift ;;
            *) echo "Usage: jt fork delete [--prd|--dev]" >&2; return 1 ;;
        esac
    done
    fork_preflight || return 1
    if ! fork_load_config "$env"; then
        echo "No $env pair recorded — nothing to delete."
        return 0
    fi
    echo "Deleting the $env pair:"
    echo "  jolteon: $JOLTEON_FORK_ID"
    echo "  agent:   $AGENT_FORK_ID"
    local reply=""
    read -rp "Sure? [y/N]: " reply || true
    case "${reply:-n}" in [Yy]*) ;; *) echo "Left alone."; return 0 ;; esac
    local id
    for id in "$JOLTEON_FORK_ID" "$AGENT_FORK_ID"; do
        if TIGER_VERSION_CHECK_INTERVAL=0 tiger service delete "$id" --confirm >/dev/null 2>&1; then
            echo "  deleted $id"
        else
            echo "  could not delete $id (already gone?)"
        fi
    done
    rm -f "$(fork_config_path "$env")"
    echo "Config removed. The cleanup job would have taken these at expiry anyway."
}

# Record a pair somebody else took — the tiger_fork.yaml workflow, or your other machine.
# The passwords still have to be in THIS machine's ~/.pgpass, so this stores them from
# Key Vault, which is where the workflow puts them.
cmd_fork_use() {
    local env="prd" ids=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --prd) env="prd"; shift ;;
            --dev) env="dev"; shift ;;
            *) ids+=("$1"); shift ;;
        esac
    done
    if [ "${#ids[@]}" -ne 2 ]; then
        echo "Usage: jt fork use <jolteon-fork-id> <agent-fork-id> [--prd|--dev]" >&2
        return 1
    fi
    fork_preflight || return 1
    local id
    for id in "${ids[@]}"; do
        [ -n "$(fork_service_status "$id")" ] || { echo "Error: no live Tiger service '$id'." >&2; return 1; }
        if fork_password_stored "$id"; then
            echo "  $id: password already in ~/.pgpass"
            continue
        fi
        local pass; pass="$(az keyvault secret show --vault-name kv-companionenergy-weu \
                              --name "tiger-fork-password-$id" --query value -o tsv 2>/dev/null || true)"
        if [ -z "$pass" ]; then
            echo "Error: no password for '$id' in ~/.pgpass or Key Vault." >&2
            echo "       Store it by hand, then retry:" >&2
            echo "       TIGER_NEW_PASSWORD=… tiger db save-password $id --password-storage pgpass" >&2
            return 1
        fi
        fork_save_password "$id" "$pass" || { echo "Error: could not store the password for '$id'." >&2; return 1; }
        echo "  $id: password stored from Key Vault"
    done
    fork_write_config "$env" "${ids[0]}" "${ids[1]}"
}

# Resolve both halves of a pair into PG_* and AGENT_PG_*, taking a fresh pair when the
# recorded one is gone. Fails loudly rather than starting half a stack: the Jolteon fork
# alone gives an assistant that refuses every conversation, which is the confusing failure
# the pairing exists to prevent.
fork_env() {
    local env="$1"
    fork_preflight || return 1

    local alive=0
    if ! fork_load_config "$env"; then
        echo "No $env fork pair recorded ($(fork_config_path "$env"))."
    elif fork_pair_alive "$JOLTEON_FORK_ID" "$AGENT_FORK_ID"; then
        alive=1
    else
        echo "The recorded $env fork pair is gone — a fork is deleted once its duration expires."
        echo "  jolteon: $JOLTEON_FORK_ID"
        echo "  agent:   $AGENT_FORK_ID"
    fi

    if [ "$alive" -eq 0 ]; then
        # A prompt rather than a silent create: a fork takes minutes to come up and bills
        # for its whole duration, so a mistyped flag should not cost either. A
        # non-interactive caller (a script, an agent) gets the create — nobody to ask.
        if [ -t 0 ]; then
            local reply=""
            read -rp "Take a fresh pair now? [Y/n]: " reply || true
            case "${reply:-y}" in
                [Nn]*) echo "Aborting. Run 'jt fork create --$env' when you want one." >&2; return 1 ;;
            esac
        else
            echo "Not a terminal — taking a fresh pair."
        fi
        cmd_fork_create "--$env" || return 1
        fork_load_config "$env" || return 1
    fi

    fork_export_service "$JOLTEON_FORK_ID" "PG_" || return 1
    fork_export_service "$AGENT_FORK_ID" "AGENT_PG_" || return 1
    if [ "$env" = "prd" ]; then
        echo "Using PRD-FORK databases — real customer data, writable"
    else
        echo "Using DEV-FORK databases — a throwaway copy of dev, writable"
    fi
    echo "  jolteon: $JOLTEON_FORK_ID ($PG_HOST:$PG_PORT)"
    echo "  agent:   $AGENT_FORK_ID ($AGENT_PG_HOST:$AGENT_PG_PORT)"
    return 0
}

# ─── Local databases ───────────────────────────────────────
#
# --local runs on jolteon_seed (:5432) beside agent_seed (:5433), both rebuilt by `jt db seed`
# from the migrations, dev's identities and a small fixture. You sign in to it with your real
# dev account, which is why the identities come from dev rather than being made up.
#
# Both servers are the ones the repo already defines — Jolteon's timescaledb in the root
# docker-compose.yml, agent-service's postgres in services/agent-service/compose.yaml. The
# seeded databases sit beside what is already there under their own names, so neither the
# `jolteon` database the repo docs use nor the `agent` one its tests use is touched by a seed.
# Overridable so a second session can seed and run its own pair without ending the first's.
LOCAL_JOLTEON_DB="${JT_LOCAL_JOLTEON_DB:-jolteon_seed}"
LOCAL_AGENT_DB="${JT_LOCAL_AGENT_DB:-agent_seed}"

# psql against one of the two local servers. -X skips ~/.psqlrc so output stays parseable.
# PGOPTIONS keeps server NOTICEs ("does not exist, skipping") out of the output.
jolteon_psql() {
    local db="$1"; shift
    PGPASSWORD=energy PGOPTIONS='-c client_min_messages=warning' \
        psql -h localhost -p 5432 -U jolteon -d "$db" -X -q -v ON_ERROR_STOP=1 "$@"
}
agent_psql() {
    local db="$1"; shift
    PGPASSWORD=agent PGOPTIONS='-c client_min_messages=warning' \
        psql -h localhost -p 5433 -U agent -d "$db" -X -q -v ON_ERROR_STOP=1 "$@"
}

# local_db_exists <jolteon|agent> <database>
local_db_exists() {
    [ -n "$("${1}_psql" postgres -Atc "SELECT 1 FROM pg_database WHERE datname = '$2'" 2>/dev/null || true)" ]
}

# Both docker Postgres servers answering, starting whichever is not. Checked with pg_isready
# first so a shell without docker access still works while the containers are up.
local_db_servers_up() {
    pg_isready -h localhost -p 5432 -q && pg_isready -h localhost -p 5433 -q && return 0
    command -v docker >/dev/null 2>&1 || { echo "Error: the local Postgres servers are down and docker is not installed." >&2; return 1; }
    echo "Starting the local Postgres servers..."
    # $REPO's compose file, never a worktree's: compose names the project after the directory
    # and binds `.data` relative to the file, so a worktree's copy would start a second
    # timescaledb on an empty data directory — and collide on the fixed container_name.
    if ! pg_isready -h localhost -p 5432 -q; then
        docker compose -f "$REPO/docker-compose.yml" up -d --wait timescaledb >/dev/null \
            || { echo "Error: could not start timescaledb ($REPO/docker-compose.yml)." >&2; return 1; }
    fi
    if ! pg_isready -h localhost -p 5433 -q; then
        docker compose -f "$(agent_service_dir)/compose.yaml" up -d --wait >/dev/null \
            || { echo "Error: could not start the agent database (services/agent-service/compose.yaml)." >&2; return 1; }
    fi
}

# The seeded Jolteon database, as PG_*. Here rather than in environments.sh because nothing
# about it is secret or differs per machine.
env_local() {
    local_db_servers_up || return 1
    if ! local_db_exists jolteon "$LOCAL_JOLTEON_DB"; then
        echo "Error: no $LOCAL_JOLTEON_DB database yet. Run 'jt db seed' first." >&2
        return 1
    fi
    export PG_HOST="localhost" PG_PORT="5432" PG_USER="jolteon" PG_PASSWORD="energy" PG_DATABASE="$LOCAL_JOLTEON_DB"
    echo "Using LOCAL seeded database ($LOCAL_JOLTEON_DB)"
}

# agent-service's database for --local, as AGENT_PG_*. sslmode=disable because the docker
# server has no TLS; with auth on, `require` would boot a service whose /readyz says db down.
agent_env_docker() {
    export AGENT_PG_HOST="localhost" AGENT_PG_PORT="5433" AGENT_PG_USER="agent" AGENT_PG_PASSWORD="agent" \
           AGENT_PG_DATABASE="$1" AGENT_PG_SSLMODE="disable"
    echo "Agent DB: local ($1)"
}

# Replace agent_db's identity mirror with jolteon_db's organizations, users and memberships,
# selected exactly as dashboard-api's identity-sync publisher selects them — the feed that
# fills the mirror in a deployed environment and cannot reach a laptop. A wholesale replace is
# safe: nothing references the mirror tables, so conversations are untouched.
local_mirror_identity() {
    local jolteon_db="$1" agent_db="$2" tmp
    tmp="$(mktemp -d)"
    jolteon_psql "$jolteon_db" -c "\copy (SELECT id, external_idp_id, name, type, coalesce(additional_features, '{}') FROM common.organization WHERE external_idp_id IS NOT NULL AND datetime_deletion_scheduled_utc IS NULL) TO '$tmp/org.tsv'" \
        && jolteon_psql "$jolteon_db" -c "\copy (SELECT id, external_idp_id, email FROM common.\"user\") TO '$tmp/user.tsv'" \
        && jolteon_psql "$jolteon_db" -c "\copy (SELECT m.user_id, m.organization_id, r.slug, m.state = 'active' FROM common.organization_membership m JOIN common.organization_role r ON r.id = m.role_id) TO '$tmp/membership.tsv'" \
        && agent_psql "$agent_db" <<SQL
BEGIN;
CREATE TEMP TABLE o (id uuid, external_idp_id text, name text, type text, additional_features text[]) ON COMMIT DROP;
CREATE TEMP TABLE u (id uuid, external_idp_id text, email text) ON COMMIT DROP;
CREATE TEMP TABLE m (user_id uuid, organization_id uuid, role text, active boolean) ON COMMIT DROP;
\copy o FROM '$tmp/org.tsv'
\copy u FROM '$tmp/user.tsv'
\copy m FROM '$tmp/membership.tsv'
DELETE FROM agent.user_organization;
DELETE FROM agent.organization;
DELETE FROM agent.app_user;
INSERT INTO agent.organization (id, external_idp_id, name, type, additional_features) SELECT * FROM o;
INSERT INTO agent.app_user (id, external_idp_id, email) SELECT * FROM u;
INSERT INTO agent.user_organization (user_id, organization_id, role, active) SELECT * FROM m;
COMMIT;
SQL
    local rc=$?
    rm -rf "$tmp"
    return "$rc"
}

# Copy the identities a real dev login needs from the dev Jolteon database into the seed:
# every role, organization, user, membership and partner link, keeping dev's UUIDs and WorkOS
# ids. Both halves matter. The WorkOS ids are what a dev login's token carries, so without
# them nobody resolves. The UUIDs are what dashboard-api pushes into the WorkOS user's
# external_id on every /users/me when the two differ, so made-up ones would overwrite your
# real dev account's on each page load. Reads dev only; the seed database must be fresh.
local_copy_dev_identity() {
    local tmp rc=0
    tmp="$(mktemp -d)"
    (
        # shellcheck source=/dev/null
        source "$HOME/.config/jt/environments.sh" >/dev/null && env_dev >/dev/null
        dev_psql() {
            PGPASSWORD="$PG_PASSWORD" PGSSLMODE=require PGCONNECT_TIMEOUT=10 \
                psql -h "$PG_HOST" -p "$PG_PORT" -U "$PG_USER" -d "$PG_DATABASE" -X -q -v ON_ERROR_STOP=1 "$@"
        }
        dev_psql -c "\copy (SELECT id, slug, name, datetime_created_utc FROM common.organization_role) TO '$tmp/role.tsv'" \
            && dev_psql -c "\copy (SELECT id, name, type, external_idp_id, datetime_created_utc, whitelabeling_config, steering_algo_name, subscription, customer_type, currency, additional_features, partner_features, silver_enrolled_at, datetime_deletion_scheduled_utc, datetime_deletion_started_utc FROM common.organization) TO '$tmp/org.tsv'" \
            && dev_psql -c "\copy (SELECT id, external_idp_id, email, datetime_created_utc FROM common.\"user\") TO '$tmp/user.tsv'" \
            && dev_psql -c "\copy (SELECT organization_id, user_id, role_id, state, datetime_created_utc FROM common.organization_membership) TO '$tmp/membership.tsv'" \
            && dev_psql -c "\copy (SELECT id, parent_organization_id, child_organization_id, datetime_created_utc FROM common.organization_relationship) TO '$tmp/relationship.tsv'"
    ) || rc=1
    # The migration seeds its own role rows with fresh ids; dev's replace them, since dev's
    # memberships point at dev's role ids.
    [ "$rc" -eq 0 ] && jolteon_psql "$LOCAL_JOLTEON_DB" <<SQL || rc=1
BEGIN;
DELETE FROM common.organization_role;
\copy common.organization_role (id, slug, name, datetime_created_utc) FROM '$tmp/role.tsv'
\copy common.organization (id, name, type, external_idp_id, datetime_created_utc, whitelabeling_config, steering_algo_name, subscription, customer_type, currency, additional_features, partner_features, silver_enrolled_at, datetime_deletion_scheduled_utc, datetime_deletion_started_utc) FROM '$tmp/org.tsv'
\copy common."user" (id, external_idp_id, email, datetime_created_utc) FROM '$tmp/user.tsv'
\copy common.organization_membership (organization_id, user_id, role_id, state, datetime_created_utc) FROM '$tmp/membership.tsv'
\copy common.organization_relationship (id, parent_organization_id, child_organization_id, datetime_created_utc) FROM '$tmp/relationship.tsv'
COMMIT;
SQL
    rm -rf "$tmp"
    return "$rc"
}

# A site and a grid connection under one real dev org, with the assistant switched on there,
# so a login into that org has something to show and something to ask about.
local_seed_fixture() {
    jolteon_psql "$LOCAL_JOLTEON_DB" -v org="$1" <<'SQL'
BEGIN;
INSERT INTO customers_v2.location (uuid, customer_uuid, name, latitude, longitude, country, zip_code, timezone, deleted)
SELECT '00000000-0000-0000-0000-000000000010', o.id, 'Local Demo Site', 50.8503, 4.3517, 'BE', '1000', 'Europe/Brussels', false
FROM common.organization o WHERE o.external_idp_id = :'org';
INSERT INTO customers_v2.asset (uuid, customer_uuid, name, location_uuid, asset_type, deleted)
SELECT '00000000-0000-0000-0000-000000000011', o.id, 'Local Grid Connection', '00000000-0000-0000-0000-000000000010', 'grid connection', false
FROM common.organization o WHERE o.external_idp_id = :'org';
-- On in Jolteon, not only in the mirror: the frontend decides whether to show the assistant
-- from dashboard-api's copy of the flag, the service from the mirror's.
UPDATE common.organization SET additional_features = array_append(coalesce(additional_features, '{}'), 'agentic_chat')
WHERE external_idp_id = :'org' AND NOT ('agentic_chat' = ANY(coalesce(additional_features, '{}')));
COMMIT;
SQL
}

# Run one migration package quietly, showing its log only when it fails. The runner echoes
# every statement, which buries the one line that matters.
local_migrate() {
    local root="$1" package="$2" log
    shift 2
    log="$(mktemp)"
    if (cd "$root" && env "$@" uv run --quiet --package="$package-migrations" python migrations/runner.py "$package") >"$log" 2>&1; then
        rm -f "$log"
        return 0
    fi
    tail -20 "$log" >&2
    rm -f "$log"
    return 1
}

# How many sessions other than ours hold one of the seeded databases open — a running
# `jt app run --local`, usually another worktree's.
local_db_sessions() {
    local n1 n2
    n1="$(jolteon_psql postgres -Atc "SELECT count(*) FROM pg_stat_activity WHERE datname = '$LOCAL_JOLTEON_DB' AND backend_type = 'client backend' AND pid <> pg_backend_pid()" 2>/dev/null || echo 0)"
    n2="$(agent_psql postgres -Atc "SELECT count(*) FROM pg_stat_activity WHERE datname = '$LOCAL_AGENT_DB' AND backend_type = 'client backend' AND pid <> pg_backend_pid()" 2>/dev/null || echo 0)"
    echo $((n1 + n2))
}

cmd_db_seed() {
    local org="" force=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --org) org="${2:-}"; [ -n "$org" ] || { echo "--org needs a WorkOS org id (org_…)" >&2; return 1; }; shift 2 ;;
            --force) force=1; shift ;;
            *) echo "Usage: jt db seed [--org <org_…>] [--force]" >&2; return 1 ;;
        esac
    done
    local root; root="$(git rev-parse --show-toplevel 2>/dev/null)" \
        || { echo "Error: run this from a Jolteon worktree." >&2; return 1; }
    command -v psql >/dev/null 2>&1 || { echo "Error: psql not found." >&2; return 1; }
    local_db_servers_up || return 1

    # Always from scratch: the identities are copied with dev's own ids, which only land
    # cleanly in an empty database, and a rebuild takes seconds. It does end whatever is
    # connected, so refuse while something is.
    local busy; busy="$(local_db_sessions)"
    if [ "$busy" -gt 0 ] && [ "$force" -eq 0 ]; then
        echo "Error: $busy session(s) still have $LOCAL_JOLTEON_DB/$LOCAL_AGENT_DB open — a running" >&2
        echo "       'jt app run --local', maybe another worktree's. Stop it, or pass --force." >&2
        return 1
    fi
    echo "Rebuilding $LOCAL_JOLTEON_DB and $LOCAL_AGENT_DB..."
    jolteon_psql postgres -c "DROP DATABASE IF EXISTS $LOCAL_JOLTEON_DB WITH (FORCE)" -c "CREATE DATABASE $LOCAL_JOLTEON_DB OWNER jolteon" || return 1
    agent_psql postgres -c "DROP DATABASE IF EXISTS $LOCAL_AGENT_DB WITH (FORCE)" -c "CREATE DATABASE $LOCAL_AGENT_DB OWNER agent" || return 1

    echo "Migrating $LOCAL_JOLTEON_DB..."
    local_migrate "$root" jolteon PG_HOST=127.0.0.1 PG_PORT=5432 PG_USER=jolteon PG_PASSWORD=energy \
        PG_DATABASE="$LOCAL_JOLTEON_DB" || { echo "Error: the Jolteon migration failed." >&2; return 1; }

    echo "Copying dev's organizations, users and memberships (needs Tailscale)..."
    local_copy_dev_identity || { echo "Error: could not copy identities from the dev database." >&2; return 1; }

    # The fixture goes under one of YOUR customer orgs, so the first login lands somewhere with
    # data. Your dev account is found by JT_DEV_EMAIL, else your git email, else that email's
    # name at companion.energy — a personal git email is common. --org picks another org.
    if [ -z "$org" ]; then
        local git_email dev_email emails
        # Quotes stripped: these land inside SQL string literals.
        git_email="$(git -C "$root" config user.email 2>/dev/null || true)"
        git_email="${git_email//\'/}"
        dev_email="${JT_DEV_EMAIL:-}"
        dev_email="${dev_email//\'/}"
        emails="'${dev_email,,}', '${git_email,,}', '${git_email%%@*}@companion.energy'"
        org="$(jolteon_psql "$LOCAL_JOLTEON_DB" -Atc "SELECT o.external_idp_id FROM common.organization o JOIN common.organization_membership m ON m.organization_id = o.id JOIN common.\"user\" u ON u.id = m.user_id WHERE lower(u.email) IN (${emails,,}) AND o.type = 'customer' AND m.state = 'active' ORDER BY o.name LIMIT 1" 2>/dev/null || true)"
    fi
    local org_name=""
    [ -n "$org" ] && org_name="$(jolteon_psql "$LOCAL_JOLTEON_DB" -Atc "SELECT name FROM common.organization WHERE external_idp_id = '${org//\'/}'" 2>/dev/null || true)"
    if [ -n "$org_name" ]; then
        echo "Adding the demo site and grid connection to '$org_name' ($org)..."
        local_seed_fixture "$org" || return 1
    else
        echo "No customer org to put the demo site under: none active for your dev account (set"
        echo "JT_DEV_EMAIL to its email), or --org names no dev org. Seeded without it."
    fi

    echo "Migrating $LOCAL_AGENT_DB..."
    local_migrate "$root" agent AGENT_DATABASE_URL="postgresql+psycopg://agent:agent@localhost:5433/$LOCAL_AGENT_DB" \
        || { echo "Error: the agent migration failed." >&2; return 1; }

    echo "Mirroring identity into $LOCAL_AGENT_DB..."
    local_mirror_identity "$LOCAL_JOLTEON_DB" "$LOCAL_AGENT_DB" || return 1

    # Gateway-named, like every deployed catalog, so the seeded setup exercises the ids prd
    # actually stores. Capabilities are left for the admin screen's refresh: the runtime
    # infers the thinking shape from the id when they are absent.
    agent_psql "$LOCAL_AGENT_DB" <<'SQL' || return 1
INSERT INTO agent.model_catalog (model_id, provider, display_name, status, is_default) VALUES
    ('anthropic/claude-sonnet-5', 'anthropic', 'claude-sonnet-5', 'enabled', true),
    ('anthropic/claude-opus-5', 'anthropic', 'claude-opus-5', 'enabled', false),
    ('anthropic/claude-haiku-4-5', 'anthropic', 'claude-haiku-4-5', 'enabled', false);
SQL

    echo ""
    cmd_db_status
    echo ""
    echo "Now: jt app run --local --agent, and sign in with your dev account."
}

cmd_db_status() {
    local row server db
    for row in "jolteon:$LOCAL_JOLTEON_DB" "agent:$LOCAL_AGENT_DB"; do
        server="${row%%:*}"; db="${row#*:}"
        if ! pg_isready -h localhost -p "$([ "$server" = jolteon ] && echo 5432 || echo 5433)" -q; then
            printf '  %-14s server down\n' "$db"
            continue
        fi
        if ! local_db_exists "$server" "$db"; then
            printf '  %-14s missing\n' "$db"
            continue
        fi
        if [ "$server" = jolteon ]; then
            printf '  %-14s %s\n' "$db" "$(jolteon_psql "$db" -Atc "SELECT 'rev ' || (SELECT string_agg(version_num, ',') FROM common.alembic_version) || ', ' || (SELECT count(*) FROM common.organization) || ' orgs, ' || (SELECT count(*) FROM common.\"user\") || ' users, ' || (SELECT count(*) FROM common.organization WHERE 'agentic_chat' = ANY(additional_features)) || ' with agentic_chat'" 2>&1 | head -1)"
        else
            printf '  %-14s %s\n' "$db" "$(agent_psql "$db" -Atc "SELECT 'rev ' || (SELECT string_agg(version_num, ',') FROM public.alembic_version) || ', ' || (SELECT count(*) FROM agent.organization) || ' orgs, ' || (SELECT count(*) FROM agent.app_user) || ' users, default model ' || coalesce((SELECT model_id FROM agent.model_catalog WHERE is_default), 'none')" 2>&1 | head -1)"
        fi
    done
}

# ─── Parallel environments ─────────────────────────────────
#
# `jt env` runs a worktree's whole app in its own network namespace, so several worktrees can
# run it at the same time. Inside, every service keeps its usual port, because each namespace
# has a localhost of its own. That is also why nothing clashes: an env cannot see the host's
# ports or another env's, and `jt app stop` inside one cannot touch the rest. The host's
# Postgres servers and Azurite are passed in by pasta, so `localhost:5432` still works inside.
#
# Each env is a systemd user unit (jt-env-<name>). It outlives the shell that started it, its
# output lands in the journal, and stopping the unit ends every process it started. The three
# ports a browser uses are published on this machine's loopback at the env's own numbers
# (JT_ENV_PORT_BASE + 10 per slot); `jt app forward --env <name>` tunnels those to a Mac's usual
# localhost:5173/8000/8140, so the frontend's hardcoded URLs and the WorkOS redirect still work.
#
# The namespace maps your uid to itself, not to root: Chromium refuses to run as root, and a
# browser inside the env is how a person (`jt env open`) or an agent checks it. Root inside is
# a spare subordinate uid (/etc/subuid) that nothing runs as.
JT_ENV_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/jt/envs"
JT_ENV_PORT_BASE="${JT_ENV_PORT_BASE:-21000}"
# One full stack (frontend, backend, the agent stack, LiteLLM, the invoice worker) holds about
# 4.5 GB, a third of it vite; the cap only stops a runaway from taking the whole machine down.
JT_ENV_MEMORY_MAX="${JT_ENV_MEMORY_MAX:-8G}"

env_state_dir() { echo "$JT_ENV_DIR/$1"; }
env_unit() { echo "jt-env-$1"; }

# An env is named after its worktree, so an agent in that worktree never has to pass a name.
env_name_for_worktree() {
    local base
    base="$(basename "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-\n' '-' | sed 's/^-*//; s/-*$//')"
    echo "${base:0:32}"
}

# The env name to act on: the explicit one, else the current worktree's.
env_resolve_name() {
    if [ -n "${1:-}" ]; then echo "$1"; return 0; fi
    local root
    root="$(git rev-parse --show-toplevel 2>/dev/null)" \
        || { echo "Error: no env name given and not in a worktree." >&2; return 1; }
    env_name_for_worktree "$root"
}

env_load() {
    local dir; dir="$(env_state_dir "$1")"
    [ -f "$dir/env.sh" ] || { echo "Error: no env '$1' ('jt env list')." >&2; return 1; }
    # shellcheck source=/dev/null
    source "$dir/env.sh"
}

# The PID holding the env's namespaces, once the unit has created them and while it lives.
env_holder() {
    local pid
    pid="$(cat "$(env_state_dir "$1")/holder.pid" 2>/dev/null || true)"
    if [ -n "$pid" ] && [ -d "/proc/$pid" ] && [ "$(readlink "/proc/$pid/ns/net")" != "$(readlink /proc/self/ns/net)" ]; then
        echo "$pid"
    fi
}

# The lowest slot whose three published ports are free here and no running env holds.
env_free_slot() {
    local slot port taken f
    for slot in $(seq 1 20); do
        taken=0
        for f in "$JT_ENV_DIR"/*/env.sh; do
            [ -f "$f" ] || continue
            if grep -qx "ENV_SLOT=$slot" "$f" \
               && systemctl --user is-active --quiet "$(env_unit "$(basename "$(dirname "$f")")")"; then
                taken=1; break
            fi
        done
        [ "$taken" -eq 1 ] && continue
        for port in $((JT_ENV_PORT_BASE + slot * 10)) $((JT_ENV_PORT_BASE + slot * 10 + 1)) $((JT_ENV_PORT_BASE + slot * 10 + 2)); do
            ss -ltnH "sport = :$port" 2>/dev/null | grep -q . && { taken=1; break; }
        done
        [ "$taken" -eq 0 ] && { echo "$slot"; return 0; }
    done
    return 1
}

# The two commands for looking at an env, each on its own line so it can be copied whole.
env_print_preview() {
    local name="$1"
    echo "Preview from your Mac (then open http://localhost:5173):"
    echo ""
    echo "    jt app forward --env $name"
    echo ""
    echo "Or on this machine, in a browser window inside the env:"
    echo ""
    echo "    jt env open $name"
    echo ""
}

cmd_env_up() {
    local name="" mode="local" agent=0 persona="" _a
    while [ $# -gt 0 ]; do
        case "$1" in
            --local|--dev|--fork|--prd-fork) mode="${1#--}"; shift ;;
            --agent) agent=1; shift ;;
            --as)    persona="${2:-}"; [ -n "$persona" ] || { echo "--as needs a persona" >&2; return 1; }; shift 2 ;;
            --name)  name="${2:-}"; shift 2 ;;
            -*)      echo "Usage: jt env up [--local|--dev|--fork|--prd-fork] [--agent] [--as <persona>] [--name <name>]" >&2; return 1 ;;
            *)       name="$1"; shift ;;
        esac
    done
    command -v pasta >/dev/null 2>&1 || { echo "Error: pasta not found — install it: sudo pacman -S passt" >&2; return 1; }
    local root; root="$(git rev-parse --show-toplevel 2>/dev/null)" \
        || { echo "Error: run this from the Jolteon worktree the env should run." >&2; return 1; }
    [ -n "$name" ] || name="$(env_name_for_worktree "$root")"
    case "$name" in [a-z0-9]*) ;; *) echo "Error: env names start with a letter or digit." >&2; return 1 ;; esac
    local unit; unit="$(env_unit "$name")"
    if systemctl --user is-active --quiet "$unit"; then
        echo "Env '$name' is already running."
        env_print_preview "$name"
        return 0
    fi
    if [ "$mode" = "prd-fork" ]; then mode="prd_fork"; fi
    if [ "$mode" = "prd_fork" ] && [ -z "$persona" ]; then
        echo "Error: --prd-fork needs a persona for now: --as root." >&2
        return 1
    fi
    # Forks are shared, billed state: an env uses the recorded pair or none, and never takes
    # one on its own from inside a unit, where nobody would see the prompt.
    if [ "$mode" = "fork" ] || [ "$mode" = "prd_fork" ]; then
        local fork_env_name="dev"; [ "$mode" = "prd_fork" ] && fork_env_name="prd"
        fork_preflight || return 1
        if ! fork_load_config "$fork_env_name" || ! fork_pair_alive "$JOLTEON_FORK_ID" "$AGENT_FORK_ID"; then
            echo "Error: no live $fork_env_name fork pair. Take one first: jt fork create --$fork_env_name" >&2
            return 1
        fi
    fi

    # The worktree has to be set up: the unit does not install anything.
    local missing=""
    [ -d "$root/.venv" ] || missing="$missing .venv"
    [ -d "$root/services/frontend/node_modules" ] || [ -d "$root/node_modules" ] || missing="$missing node_modules"
    [ -f "$root/services/dashboard-api/.env" ] || missing="$missing services/dashboard-api/.env"
    if [ -n "$missing" ]; then
        echo "Error: this worktree is not set up (missing:$missing). Run 'jt setup' in it first." >&2
        return 1
    fi

    local db_suffix="${name//-/_}" jolteon_db="" agent_db=""
    if [ "$mode" = "local" ]; then
        jolteon_db="jolteon_$db_suffix"; agent_db="agent_$db_suffix"
        local_db_servers_up || return 1
        if ! local_db_exists jolteon "$jolteon_db" || ! local_db_exists agent "$agent_db"; then
            # A separate jt, not cmd_db_seed here: the seeded database names are read once, when
            # jt starts, so an in-process call would rebuild the default pair instead.
            echo "Seeding this env's databases ($jolteon_db, $agent_db)..."
            JT_LOCAL_JOLTEON_DB="$jolteon_db" JT_LOCAL_AGENT_DB="$agent_db" "$(readlink -f "${BASH_SOURCE[0]}")" db seed \
                | sed -e '/^Now: /d' -e '/^$/d' -e 's/^/  /' \
                || { echo "Error: seeding this env's databases failed (above)." >&2; return 1; }
        fi
    fi

    local slot; slot="$(env_free_slot)" || { echo "Error: no free env slot (20 in use?)." >&2; return 1; }
    local dir; dir="$(env_state_dir "$name")"
    mkdir -p "$dir"
    rm -f "$dir/holder.pid"
    {
        printf 'ENV_NAME=%q\n' "$name"
        printf 'ENV_WORKTREE=%q\n' "$root"
        printf 'ENV_MODE=%q\n' "$mode"
        printf 'ENV_AGENT=%q\n' "$agent"
        printf 'ENV_PERSONA=%q\n' "$persona"
        printf 'ENV_SLOT=%s\n' "$slot"
        printf 'ENV_PORT_WEB=%s\n' $((JT_ENV_PORT_BASE + slot * 10))
        printf 'ENV_PORT_API=%s\n' $((JT_ENV_PORT_BASE + slot * 10 + 1))
        printf 'ENV_PORT_AGENT=%s\n' $((JT_ENV_PORT_BASE + slot * 10 + 2))
        printf 'ENV_JOLTEON_DB=%q\n' "$jolteon_db"
        printf 'ENV_AGENT_DB=%q\n' "$agent_db"
        printf 'ENV_CREATED=%q\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } > "$dir/env.sh"

    systemctl --user reset-failed "$unit" >/dev/null 2>&1 || true
    systemd-run --user --quiet --unit="$unit" --collect \
        --property=MemoryMax="$JT_ENV_MEMORY_MAX" \
        --working-directory="$root" \
        --setenv=PATH="$PATH" --setenv=HOME="$HOME" \
        -- "$(readlink -f "${BASH_SOURCE[0]}")" env _run "$name" \
        || { echo "Error: could not start the $unit unit." >&2; return 1; }

    local what="$mode"; [ "$agent" -eq 1 ] && what="$what, full agent stack"
    echo "Starting env '$name' ($what) — logs: jt env logs $name"
    local waited=0 ready=0
    while [ "$waited" -lt 240 ]; do
        if ! systemctl --user is-active --quiet "$unit"; then
            echo "Error: env '$name' stopped while starting. Last lines of its log:" >&2
            journalctl --user -u "$unit" -o cat -n 25 --no-pager >&2
            return 1
        fi
        if [ -n "$(env_holder "$name")" ] \
           && cmd_env_exec "$name" -- curl -sf -o /dev/null --max-time 2 http://127.0.0.1:8000/health 2>/dev/null \
           && cmd_env_exec "$name" -- curl -sf -o /dev/null --max-time 2 http://localhost:5173/ 2>/dev/null \
           && { [ "$agent" -eq 0 ] || cmd_env_exec "$name" -- curl -sf -o /dev/null --max-time 2 http://127.0.0.1:8140/readyz 2>/dev/null; }; then
            ready=1; break
        fi
        sleep 3; waited=$((waited + 3))
    done
    if [ "$ready" -eq 0 ]; then
        echo "Warning: env '$name' is running but not answering yet after ${waited}s — check 'jt env logs $name'." >&2
    else
        echo "Env '$name' is up after ${waited}s."
    fi
    echo ""
    env_print_preview "$name"
}

# The unit's main process. Builds the namespaces, attaches pasta, then becomes `jt app run`
# inside them — so when the app stops, the unit stops, and systemd ends pasta and the holder.
cmd_env_run() {
    local name="$1" dir
    env_load "$name" || return 1
    dir="$(env_state_dir "$name")"
    cd "$ENV_WORKTREE" || return 1
    local me gid subuid subgid
    me="$(id -u)"; gid="$(id -g)"
    subuid="$(awk -F: -v u="$(id -un)" '$1 == u { print $2; exit }' /etc/subuid)"
    subgid="$(awk -F: -v u="$(id -un)" '$1 == u { print $2; exit }' /etc/subgid)"
    [ -n "$subuid" ] && [ -n "$subgid" ] || { echo "Error: no /etc/subuid or /etc/subgid range for $(id -un)." >&2; return 1; }

    unshare --user --net --map-users="0:$subuid:1" --map-users="$me:$me:1" \
        --map-groups="0:$subgid:1" --map-groups="$gid:$gid:1" --setuid="$me" --setgid="$gid" \
        -- sleep infinity &
    local holder=$! i
    for i in $(seq 1 50); do
        [ -s "/proc/$holder/uid_map" ] && [ "$(readlink "/proc/$holder/ns/net")" != "$(readlink /proc/self/ns/net)" ] && break
        sleep 0.1
    done
    # Browser ports in: the frontend on both loopbacks (vite may bind either), backend and
    # agent-service on IPv4 where they listen. Host services out: Postgres ×2 and Azurite.
    pasta --config-net -q --host-lo-to-ns-lo \
        -t "127.0.0.1/$ENV_PORT_WEB:5173" -t "::1/$ENV_PORT_WEB:5173" \
        -t "127.0.0.1/$ENV_PORT_API:8000" -t "127.0.0.1/$ENV_PORT_AGENT:8140" \
        -T 5432,5433,10000 "$holder" \
        || { echo "Error: pasta could not set up the env's network." >&2; kill "$holder"; return 1; }
    echo "$holder" > "$dir/holder.pid"

    local -a run=(app run "--$ENV_MODE")
    [ "$ENV_MODE" = "prd_fork" ] && run=(app run --prd-fork)
    [ "$ENV_AGENT" = "1" ] && run+=(--agent)
    [ -n "$ENV_PERSONA" ] && run+=(--as "$ENV_PERSONA")
    exec nsenter --target "$holder" --user --net --preserve-credentials -- \
        env JT_LOCAL_JOLTEON_DB="$ENV_JOLTEON_DB" JT_LOCAL_AGENT_DB="$ENV_AGENT_DB" JT_ENV_NAME="$name" \
        "$(readlink -f "${BASH_SOURCE[0]}")" "${run[@]}"
}

# Run a command inside an env's network: `jt env exec [name] -- curl localhost:8000/health`.
# AGENT_BROWSER_SESSION keeps agent-browser's daemon — and its Chromium — inside this env too.
cmd_env_exec() {
    local name=""
    [ "${1:-}" != "--" ] && [ $# -gt 0 ] && { name="$1"; shift; }
    [ "${1:-}" = "--" ] && shift
    [ $# -gt 0 ] || { echo "Usage: jt env exec [name] -- <command>" >&2; return 1; }
    name="$(env_resolve_name "$name")" || return 1
    local holder; holder="$(env_holder "$name")"
    [ -n "$holder" ] || { echo "Error: env '$name' is not running ('jt env up')." >&2; return 1; }
    nsenter --target "$holder" --user --net --preserve-credentials -- \
        env AGENT_BROWSER_SESSION="jt-env-$name" JT_ENV_NAME="$name" "$@"
}

# A browser window inside the env, with a profile of its own, for a person to look at it.
cmd_env_open() {
    local name; name="$(env_resolve_name "${1:-}")" || return 1
    local path="${2:-/}"
    [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ] || { echo "Error: no display here. From a Mac, use: jt app forward --env $name" >&2; return 1; }
    local browser
    browser="$(command -v chromium || command -v google-chrome-stable || true)"
    [ -n "$browser" ] || { echo "Error: no chromium or google-chrome-stable to open." >&2; return 1; }
    mkdir -p "$(env_state_dir "$name")/browser"
    setsid -f "$(readlink -f "${BASH_SOURCE[0]}")" env exec "$name" -- "$browser" --user-data-dir="$(env_state_dir "$name")/browser" \
        --no-first-run --new-window "http://localhost:5173${path}" >/dev/null 2>&1
    echo "Opened env '$name' in a browser window of its own."
}

cmd_env_logs() {
    local name="" follow=()
    while [ $# -gt 0 ]; do
        case "$1" in -f|--follow) follow=(-f); shift ;; *) name="$1"; shift ;; esac
    done
    name="$(env_resolve_name "$name")" || return 1
    journalctl --user -u "$(env_unit "$name")" -o cat --no-pager -n 200 "${follow[@]}"
}

cmd_env_ports() {
    local name; name="$(env_resolve_name "${1:-}")" || return 1
    env_load "$name" || return 1
    echo "web=$ENV_PORT_WEB api=$ENV_PORT_API agent=$ENV_PORT_AGENT"
}

cmd_env_list() {
    local dir name unit state mem any=0
    for dir in "$JT_ENV_DIR"/*/; do
        [ -f "$dir/env.sh" ] || continue
        name="$(basename "$dir")"
        (
            env_load "$name" || exit 0
            unit="$(env_unit "$name")"
            state="$(systemctl --user is-active "$unit" 2>/dev/null || true)"
            mem="$(systemctl --user show -p MemoryCurrent --value "$unit" 2>/dev/null || true)"
            case "$mem" in ''|'[not set]'|infinity) mem="-" ;; *) mem="$((mem / 1024 / 1024)) MB" ;; esac
            local what="$ENV_MODE"; [ "$ENV_AGENT" = "1" ] && what="$what+agent"
            printf '%-32s %-9s %-14s %-9s %s\n' "$name" "$state" "$what" "$mem" "$ENV_WORKTREE"
            [ "$state" = "active" ] && printf '%-32s preview: jt app forward --env %s   |   jt env open %s\n' "" "$name" "$name"
        )
        any=1
    done
    [ "$any" -eq 1 ] || echo "No envs. Start one from a worktree: jt env up [--agent]"
}

cmd_env_down() {
    local name="" all=0 purge=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --all)   all=1; shift ;;
            --purge) purge=1; shift ;;
            *)       name="$1"; shift ;;
        esac
    done
    local -a names=()
    if [ "$all" -eq 1 ]; then
        local dir
        for dir in "$JT_ENV_DIR"/*/; do
            if [ -f "$dir/env.sh" ]; then names+=("$(basename "$dir")"); fi
        done
    else
        local one; one="$(env_resolve_name "$name")" || return 1
        names=("$one")
    fi
    local n
    for n in "${names[@]}"; do
        [ -n "$n" ] || continue
        if [ -n "$(env_holder "$n")" ]; then
            cmd_env_exec "$n" -- agent-browser close >/dev/null 2>&1 || true
        fi
        systemctl --user stop "$(env_unit "$n")" >/dev/null 2>&1 || true
        if [ "$purge" -eq 1 ] && env_load "$n" 2>/dev/null && [ -n "$ENV_JOLTEON_DB" ]; then
            jolteon_psql postgres -c "DROP DATABASE IF EXISTS $ENV_JOLTEON_DB WITH (FORCE)" >/dev/null 2>&1 || true
            agent_psql postgres -c "DROP DATABASE IF EXISTS $ENV_AGENT_DB WITH (FORCE)" >/dev/null 2>&1 || true
            rm -rf "$(env_state_dir "$n")"
            echo "Stopped env '$n' and dropped its databases."
        else
            rm -f "$(env_state_dir "$n")/holder.pid"
            echo "Stopped env '$n' (its databases stay; --purge drops them)."
        fi
    done
}

prompt_env() {
    local default="$1"
    local default_num
    case "$default" in
        dev)      default_num=1 ;;
        fork)     default_num=2 ;;
        prd_fork) default_num=3 ;;
        local)    default_num=4 ;;
    esac
    echo "Select environment:" >&2
    echo "  1) dev       (writable)" >&2
    echo "  2) fork      (Tiger fork of dev — for migrations)" >&2
    echo "  3) prd-fork  (Tiger fork of prd — real data, writable, throwaway; needs --as)" >&2
    echo "  4) local     (seeded databases on this machine — 'jt db seed')" >&2
    local choice
    read -rp "Environment [$default_num]: " choice
    case "${choice:-$default_num}" in
        1|dev)               echo "dev" ;;
        2|fork)              echo "fork" ;;
        3|prd-fork|prd_fork) echo "prd_fork" ;;
        4|local)             echo "local" ;;
        *)                   echo "Invalid choice" >&2; exit 1 ;;
    esac
}

# ─── Worktree commands ─────────────────────────────────────

cmd_worktree_create() {
    local branch="${1:-}"
    local preamble="${2:-}"
    [ -z "$branch" ] && { echo "Usage: jt worktree create <branch>"; exit 1; }
    local worktree_dir; worktree_dir="$(wt_dir "$branch")"

    if [ -d "$worktree_dir" ]; then
        open_existing_worktree_or_exit "$branch" "$worktree_dir"
    fi

    echo "Creating worktree: $branch"
    git -C "$REPO" fetch origin main --quiet
    mkdir -p "$(dirname "$worktree_dir")"
    git -C "$REPO" worktree add -b "$branch" "$worktree_dir" origin/main
    git -C "$worktree_dir" push -u origin "$branch" --quiet

    post_create_worktree "$worktree_dir" "$preamble"
}

cmd_worktree_checkout() {
    local branch="${1:-}"
    local preamble="${2:-}"
    if [ -z "$branch" ]; then
        # Fuzzy-pick a remote branch that isn't already checked out somewhere.
        echo "Fetching remote branches..." >&2
        git -C "$REPO" fetch origin --prune --quiet
        local checked_out
        checked_out="$(git -C "$REPO" worktree list --porcelain | awk '/^branch /{sub("refs/heads/","",$2); print $2}')"
        branch="$(git -C "$REPO" for-each-ref --format='%(refname:short)' refs/remotes/origin \
            | sed 's#^origin/##' | grep -vxF HEAD \
            | grep -vxF "$checked_out" | sort -u \
            | pick_line "checkout> ")" || { echo "Aborted."; exit 0; }
    fi
    [ -z "$branch" ] && { echo "Usage: jt worktree checkout <branch>"; exit 1; }
    local worktree_dir; worktree_dir="$(wt_dir "$branch")"

    if [ -d "$worktree_dir" ]; then
        open_existing_worktree_or_exit "$branch" "$worktree_dir"
    fi

    echo "Fetching remote branch: $branch"
    git -C "$REPO" fetch origin "$branch" --quiet

    if ! git -C "$REPO" rev-parse "origin/$branch" >/dev/null 2>&1; then
        echo "Error: remote branch 'origin/$branch' not found."
        echo "Use 'jt worktree create $branch' to create a new branch instead."
        exit 1
    fi

    echo "Creating worktree: $branch"
    mkdir -p "$(dirname "$worktree_dir")"
    git -C "$REPO" worktree add "$worktree_dir" "origin/$branch"
    git -C "$worktree_dir" checkout -b "$branch" 2>/dev/null || true

    post_create_worktree "$worktree_dir" "$preamble"
}

cmd_worktree_open() {
    local branch="${1:-}"
    local target_dir=""

    if [ -z "$branch" ]; then
        # Interactive picker over all worktrees (branch \t dir).
        local pick
        pick="$(worktrees_tsv | pick_line "worktree> ")" || { echo "Aborted."; exit 0; }
        target_dir="$(printf '%s' "$pick" | cut -f2)"
        [ -n "$target_dir" ] || { echo "No selection."; exit 1; }
    else
        target_dir="$(wt_dir "$branch")"
        if [ ! -d "$target_dir" ]; then
            echo "Error: no worktree at $target_dir"
            echo "Use 'jt worktree list' to see available worktrees, or 'jt worktree create $branch' to create one."
            exit 1
        fi
    fi

    if [ -n "${JT_CD_FILE:-}" ]; then
        printf '%s\n' "$target_dir" > "$JT_CD_FILE"
        exit 0
    fi

    cd "$target_dir"
    exec "$SHELL"
}

# ─── Worktree dashboard (shared helpers) ──────────────────────
#
# 'jt wt' opens an interactive fzf dashboard; 'jt wt list' prints the same
# data statically. Both share the collectors/renderers below so the two views
# never drift.

# _wt_trunc <str> <width> [end]   (end=1 -> keep tail / left ellipsis)
_wt_trunc() {
    local s="$1" w="$2" end="${3:-0}"
    (( ${#s} <= w )) && { printf '%s' "$s"; return; }
    if (( end )); then printf '…%s' "${s: -$((w - 1))}"; else printf '%s…' "${s:0:$((w - 1))}"; fi
}

# _wt_daylabel <epoch> <today-ymd> <yesterday-ymd>  ->  "Today  2026-07-13"
_wt_daylabel() {
    local act="$1" today="$2" yest="$3" day
    day=$(date -d "@$act" +%Y-%m-%d)
    case "$day" in
        "$today") printf 'Today      %s' "$day" ;;
        "$yest")  printf 'Yesterday  %s' "$day" ;;
        *)        printf '%s  %s' "$(date -d "@$act" +'%a %d %b')" "$day" ;;
    esac
}

# Emit one sorted TSV record per worktree, most-recent activity first:
#   act \t branch \t dir \t src \t prstate \t prnum \t prtitle \t subject
# Activity = max(last-commit time, folder mtime). PR fields come from a single
# 'gh pr list' call; subject is the last commit's subject (fallback summary).
_wt_collect() {
    declare -A pr_state pr_num pr_title
    if command -v gh >/dev/null 2>&1; then
        local ref st num title
        while IFS=$'\t' read -r ref st num title; do
            [ -z "$ref" ] && continue
            [ -n "${pr_state[$ref]:-}" ] && continue   # gh lists newest first; keep it
            pr_state[$ref]="$st"; pr_num[$ref]="$num"; pr_title[$ref]="$title"
        done < <( (cd "$REPO" && gh pr list --state all --limit 400 \
            --json number,title,headRefName,state,isDraft \
            --jq '.[] | [.headRefName, (if .isDraft then "DRAFT" else .state end), (.number|tostring), .title] | @tsv') 2>/dev/null )
    fi

    local rows="" branch dir logline ct subj mtime act src
    while IFS=$'\t' read -r branch dir; do
        [ -d "$dir" ] || continue
        logline=$(git -C "$dir" log -1 --format='%ct%x09%s' 2>/dev/null) || true
        ct=${logline%%$'\t'*}; subj=${logline#*$'\t'}
        [ "$subj" = "$logline" ] && subj=""            # no tab -> no commits
        [[ "$ct" =~ ^[0-9]+$ ]] || ct=0
        mtime=$(stat -c %Y "$dir" 2>/dev/null) || true; mtime=${mtime:-0}
        act=$ct; [ "$mtime" -gt "$act" ] && act=$mtime
        if   [ "$dir" = "$REPO" ];                     then src=main
        elif [[ "$dir" == "$WORKTREES"/* ]];           then src=jt
        elif [[ "$dir" == *"/.claude/worktrees/"* ]];  then src=claude
        elif [[ "$dir" == *"/emdash/"* || "$dir" == *"/.emdash/"* ]]; then src=emdash
        elif [[ "$dir" == *"/workspaces/"* ]];         then src=wksp
        else src=other
        fi
        rows+="$act"$'\t'"$branch"$'\t'"$dir"$'\t'"$src"$'\t'"${pr_state[$branch]:-}"$'\t'"${pr_num[$branch]:-}"$'\t'"${pr_title[$branch]:-}"$'\t'"$subj"$'\n'
    done < <(git -C "$REPO" worktree list --porcelain 2>/dev/null \
        | awk '/^worktree / { d=substr($0,10) } /^branch / { b=$2; sub("refs/heads/","",b); print b "\t" d }')

    [ -z "$rows" ] && return 0
    printf '%s' "$rows" | sort -t$'\t' -k1,1nr
}

# Render one dashboard row (no leading day header, no trailing newline).
#   _wt_render_row <color 0|1> <collect-record>
_wt_render_row() {
    local color="$1" rec="$2"
    local act branch dir src prstate prnum prtitle subj
    IFS=$'\t' read -r act branch dir src prstate prnum prtitle subj <<<"$rec"
    local reset dim bold green yellow purple red cyan blue grey
    if [ "$color" = 1 ]; then
        reset=$'\e[0m'; dim=$'\e[2m'; bold=$'\e[1m'
        green=$'\e[32m'; yellow=$'\e[33m'; purple=$'\e[35m'
        red=$'\e[31m'; cyan=$'\e[36m'; blue=$'\e[34m'; grey=$'\e[90m'
    else reset=; dim=; bold=; green=; yellow=; purple=; red=; cyan=; blue=; grey=; fi

    local dot statecol summary badge badgecol tm
    case "$prstate" in
        OPEN)   dot="${green}●${reset}";  statecol="$green" ;;
        DRAFT)  dot="${yellow}◐${reset}"; statecol="$yellow" ;;
        MERGED) dot="${purple}●${reset}"; statecol="$purple" ;;
        CLOSED) dot="${red}●${reset}";    statecol="$red" ;;
        *)      dot="${grey}○${reset}";   statecol="" ;;
    esac
    if [ -n "$prnum" ]; then
        summary="${statecol}#${prnum}${reset} $(_wt_trunc "$prtitle" 58)"
    else
        summary="${dim}$(_wt_trunc "${subj:-—}" 58)${reset}"
    fi
    case "$src" in
        main)   badgecol="$bold" ;;
        jt)     badgecol="$cyan" ;;
        emdash) badgecol="$purple" ;;
        claude) badgecol="$blue" ;;
        *)      badgecol="$grey" ;;
    esac
    badge=$(printf '%-8s' "[$src]")
    tm=$(date -d "@$act" +%H:%M)
    printf '  %s%s%s %s  %s%s%s  %s  %s' \
        "$dim" "$tm" "$reset" "$dot" \
        "$badgecol" "$badge" "$reset" \
        "$(printf '%-42s' "$(_wt_trunc "$branch" 42)")" \
        "$summary"
}

cmd_worktree_list() {
    # Static WIP dashboard: every worktree in day sections, newest first.
    local color=0; [ -t 1 ] && color=1
    local reset dim bold green yellow purple grey
    if [ "$color" = 1 ]; then
        reset=$'\e[0m'; dim=$'\e[2m'; bold=$'\e[1m'
        green=$'\e[32m'; yellow=$'\e[33m'; purple=$'\e[35m'; grey=$'\e[90m'
    else reset=; dim=; bold=; green=; yellow=; purple=; grey=; fi

    local data; data=$(_wt_collect)
    if [ -z "$data" ]; then echo "(no worktrees)"; return; fi

    local total open draft merged nopr
    total=$(printf '%s\n' "$data" | grep -c .) || true
    read -r open draft merged nopr < <(printf '%s\n' "$data" | awk -F'\t' '
        { if($5=="OPEN")o++; else if($5=="DRAFT")d++; else if($5=="MERGED")m++; else if($5=="")n++ }
        END { printf "%d %d %d %d\n", o+0, d+0, m+0, n+0 }') || true
    printf '%s%s worktrees%s  %s%s open%s · %s%s draft%s · %s%s merged%s · %s%s no-PR%s\n' \
        "$bold" "$total" "$reset" \
        "$green" "$open" "$reset" "$yellow" "$draft" "$reset" \
        "$purple" "$merged" "$reset" "$grey" "$nopr" "$reset"

    local today yesterday
    today=$(date +%Y-%m-%d)
    yesterday=$(date -d 'yesterday' +%Y-%m-%d 2>/dev/null) || yesterday=$(date -v-1d +%Y-%m-%d)

    local cur_day="" rec act day
    while IFS= read -r rec; do
        act=${rec%%$'\t'*}
        day=$(date -d "@$act" +%Y-%m-%d)
        if [ "$day" != "$cur_day" ]; then
            cur_day="$day"
            printf '\n%s%s%s\n' "$bold" "$(_wt_daylabel "$act" "$today" "$yesterday")" "$reset"
        fi
        printf '%s\n' "$(_wt_render_row "$color" "$rec")"
    done <<<"$data"

    printf '\n%s● open  ◐ draft  ● merged  ● closed  ○ no PR%s\n' "$dim" "$reset"
}

# Path to the dashboard feed cache. A fixed per-user path (not $$-based) so the
# fzf 'reload' subprocess (_fzffeed) and the parent UI process share one file:
# the UI builds the feed once, reuses it across the sessions drill-in round-trip
# so returning is instant, and 'Ctrl-X' remove rewrites it in place via _fzffeed.
_wt_feed_cache() {
    local d="${XDG_CACHE_HOME:-$HOME/.cache}/jt"
    mkdir -p "$d" 2>/dev/null || d="${TMPDIR:-/tmp}"
    printf '%s/wt-feed' "$d"
}

# Internal: feed lines for the fzf UI. Fields (TAB-separated):
#   1 visible(colored)  2 kind(row|header)  3 dir  4 branch  5 prstate  6 prnum  7 prtitle
_wt_fzf_feed() {
    local data; data=$(_wt_collect)
    [ -z "$data" ] && return 0
    local today yesterday
    today=$(date +%Y-%m-%d)
    yesterday=$(date -d 'yesterday' +%Y-%m-%d 2>/dev/null) || yesterday=$(date -v-1d +%Y-%m-%d)

    local bold=$'\e[1m' dim=$'\e[2m' reset=$'\e[0m'
    local cur_day="" act branch dir src prstate prnum prtitle subj day rec vis
    while IFS=$'\t' read -r act branch dir src prstate prnum prtitle subj; do
        day=$(date -d "@$act" +%Y-%m-%d)
        if [ "$day" != "$cur_day" ]; then
            cur_day="$day"
            printf '%s── %s ──%s\theader\t\t\t\t\t\n' \
                "$bold$dim" "$(_wt_daylabel "$act" "$today" "$yesterday")" "$reset"
        fi
        rec="$act"$'\t'"$branch"$'\t'"$dir"$'\t'"$src"$'\t'"$prstate"$'\t'"$prnum"$'\t'"$prtitle"$'\t'"$subj"
        vis=$(_wt_render_row 1 "$rec")
        printf '%s\trow\t%s\t%s\t%s\t%s\t%s\n' "$vis" "$dir" "$branch" "$prstate" "$prnum" "$prtitle"
    done <<<"$data"
}

# Internal: fzf preview pane.  _preview <dir> <prstate> <prnum> <prtitle>
cmd_worktree_preview() {
    local dir="${1:-}" prstate="${2:-}" prnum="${3:-}" prtitle="${4:-}"
    [ -n "$dir" ] && [ -d "$dir" ] || return 0
    local reset=$'\e[0m' dim=$'\e[2m' bold=$'\e[1m' cyan=$'\e[36m' yellow=$'\e[33m'
    local branch; branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null) || true
    printf '%s%s%s\n%s%s%s\n\n' "$bold" "${branch:-?}" "$reset" "$dim" "$dir" "$reset"
    if [ -n "$prnum" ]; then
        printf '%sPR #%s%s  (%s)\n%s\n\n' "$cyan" "$prnum" "$reset" "${prstate:-?}" "$prtitle"
    else
        printf '%sno PR%s\n\n' "$dim" "$reset"
    fi
    local dirty ab ahead behind
    dirty=$(git -C "$dir" status --porcelain 2>/dev/null | grep -c .) || true
    ab=$(git -C "$dir" rev-list --left-right --count origin/main...HEAD 2>/dev/null) || true
    behind=$(printf '%s' "$ab" | awk '{print $1+0}'); ahead=$(printf '%s' "$ab" | awk '{print $2+0}')
    printf '%s↑%s ahead  ↓%s behind  ·  %s file(s) dirty%s\n\n' \
        "$dim" "${ahead:-0}" "${behind:-0}" "${dirty:-0}" "$reset"
    printf '%s── recent commits ──%s\n' "$dim" "$reset"
    git -C "$dir" log -8 --color=always --format='%C(yellow)%h%Creset %s %C(dim)%cr%Creset' 2>/dev/null || true
}

# Internal: copy text to the clipboard (best-effort across platforms/WSL).
_wt_copy() {
    local text="$1" c
    for c in pbcopy wl-copy xclip; do
        command -v "$c" >/dev/null 2>&1 || continue
        case "$c" in
            xclip) printf '%s' "$text" | xclip -selection clipboard ;;
            *)     printf '%s' "$text" | "$c" ;;
        esac
        return
    done
    for c in clip.exe /mnt/c/Windows/System32/clip.exe; do
        if command -v "$c" >/dev/null 2>&1 || [ -x "$c" ]; then
            printf '%s' "$text" | "$c"; return
        fi
    done
    printf '%s\n' "$text"   # last resort: just print it
}

# Internal: open a branch's PR in the browser.
_wt_prweb() {
    local branch="$1" url
    url=$( (cd "$REPO" && gh pr view "$branch" --json url --jq .url) 2>/dev/null ) || true
    [ -z "$url" ] && { echo "No PR found for $branch"; return 0; }
    if   command -v wslview  >/dev/null 2>&1; then wslview "$url"
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url"
    else echo "$url"; fi
}

# Internal: open a worktree in Zed (detached GUI). No-op if zed isn't found.
_wt_zed() {
    local dir="${1:-}" zed_cmd
    [ -d "$dir" ] || return 0
    zed_cmd="$(find_zed)" || return 0
    ("$zed_cmd" "$dir" >/dev/null 2>&1 &)
}

# Internal: remove one or more worktrees by their actual dirs (works for any
# source, not just jt-managed trees whose path is derivable from the branch).
# Called by the UI with the TAB-marked rows' dirs (or the highlighted row's dir
# when nothing is marked). Confirms once for the whole batch. The main checkout
# ($REPO) is never removed. Its branch is resolved per-dir and deleted too.
_wt_rm_multi() {
    local dirs=() d
    for d in "$@"; do
        [ -d "$d" ] || continue                     # skip blanks / day headers
        [ "$d" = "$REPO" ] && { echo "Skipping main checkout: $d"; continue; }
        dirs+=("$d")
    done
    [ "${#dirs[@]}" -eq 0 ] && { echo "Nothing to remove."; return 0; }

    echo "Remove ${#dirs[@]} worktree(s)?"
    for d in "${dirs[@]}"; do printf '  %s\n' "$d"; done
    local confirm
    read -rp "Proceed? [y/N] " confirm </dev/tty || return 0
    [[ "$confirm" =~ ^[Yy]$ ]] || { echo "Kept."; return 0; }

    local branch
    for d in "${dirs[@]}"; do
        branch="$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)" || branch=""
        git -C "$REPO" worktree remove "$d" 2>/dev/null \
            || git -C "$REPO" worktree remove --force "$d"
        [ -n "$branch" ] && [ "$branch" != HEAD ] \
            && git -C "$REPO" branch -d "$branch" 2>/dev/null \
            && echo "Deleted branch: $branch" || true
        echo "Removed: $d"
    done
    read -rp "Press enter to continue… " _ </dev/tty 2>/dev/null || true
}

# New worktree from a blank branch, a GitHub issue, or a GitHub PR.
cmd_worktree_new() {
    echo "New worktree from:"
    echo "  1) blank branch"
    echo "  2) GitHub issue"
    echo "  3) GitHub PR"
    local kind; read -rp "Choice [1]: " kind </dev/tty || { echo "Aborted."; return 0; }
    case "${kind:-1}" in
        1|blank|b)
            local br; read -rp "Branch name: " br </dev/tty || { echo "Aborted."; return 0; }
            [ -z "$br" ] && { echo "Aborted."; return 0; }
            cmd_worktree_create "$br"
            ;;
        2|issue|i) cmd_issue_start ;;   # picks an issue, seeds an agent preamble
        3|pr|p)    cmd_pr_review ;;      # checks out the PR branch as a worktree
        *)         echo "Aborted." ;;
    esac
}

# Interactive fzf dashboard. Arrow keys to move; keys to act (see --header).
# Encode a directory to its Claude session-store folder name (Claude replaces
# both '/' and '.' with '-' when deriving the projects/<name> directory).
_wt_session_dir() {
    printf '%s/.claude/projects/%s' "$HOME" "$(printf '%s' "$1" | sed 's#[/.]#-#g')"
}

# Internal: fzf preview for a Claude session .jsonl — title + recent prompts.
cmd_session_preview() {
    local f="${1:-}"
    [ -f "$f" ] || return 0
    local reset=$'\e[0m' dim=$'\e[2m' bold=$'\e[1m' cyan=$'\e[36m'
    local title
    title=$(tac "$f" 2>/dev/null | grep -m1 -aE '"type": *"ai-title"' \
        | sed -E 's/.*"aiTitle": *"//; s/".*$//') || true
    printf '%s%s%s\n%s%s%s\n\n' "$bold" "${title:-(untitled)}" "$reset" \
        "$dim" "$(basename "$f" .jsonl)" "$reset"
    printf '%s── recent prompts ──%s\n' "$dim" "$reset"
    tac "$f" 2>/dev/null | grep -aE '"type": *"last-prompt"' \
        | sed -E 's/.*"lastPrompt": *"//; s/".*$//; s/\\n/ /g' \
        | awk '!seen[$0]++' | head -8 \
        | while IFS= read -r line; do
            printf '%s•%s %s\n' "$cyan" "$reset" "$(printf '%s' "$line" | cut -c1-72)"
          done
}

# Drill-in: pick a Claude session recorded in this worktree and resume it.
cmd_worktree_sessions() {
    local dir="${1:-}"
    [ -n "$dir" ] || return 0
    local self; self=$(command -v jt 2>/dev/null) || true
    [ -x "$self" ] || self="$0"

    local proj; proj="$(_wt_session_dir "$dir")"
    shopt -s nullglob
    local files=("$proj"/*.jsonl)
    shopt -u nullglob
    if [ "${#files[@]}" -eq 0 ]; then
        echo "No Claude sessions recorded in $dir"
        echo "(only sessions started at the worktree root are shown)"
        echo
        echo "Press enter to go back…"
        read -r _ </dev/tty 2>/dev/null || true
        return 0
    fi

    # Build feed: "visible(colored)\tid\tfile", newest first.
    local dim=$'\e[2m' reset=$'\e[0m' feed="" f id mt title tm
    feed=$(
        for f in "${files[@]}"; do
            id=$(basename "$f" .jsonl)
            mt=$(stat -c %Y "$f" 2>/dev/null) || true; mt=${mt:-0}
            title=$(tac "$f" 2>/dev/null | grep -m1 -aE '"type": *"ai-title"' \
                | sed -E 's/.*"aiTitle": *"//; s/".*$//') || true
            [ -z "$title" ] && title=$(tac "$f" 2>/dev/null | grep -m1 -aE '"type": *"last-prompt"' \
                | sed -E 's/.*"lastPrompt": *"//; s/".*$//; s/\\n/ /g') || true
            [ -z "$title" ] && title="(untitled)"
            printf '%s\t%s\t%s\t%s\n' "$mt" "$id" "$title" "$f"
        done | sort -t$'\t' -k1,1nr | while IFS=$'\t' read -r mt id title f; do
            tm=$(date -d "@$mt" +'%a %d %b %H:%M')
            printf '%s%s%s  %s  %s%s%s\trow\t%s\t%s\n' \
                "$dim" "$tm" "$reset" "$(_wt_trunc "$title" 60)" \
                "$dim" "${id:0:8}" "$reset" "$id" "$f"
        done
    )

    local out key sel id2
    out=$(printf '%s\n' "$feed" | fzf --ansi --delimiter=$'\t' --with-nth=1 \
        --reverse --height=100% --no-sort --no-multi \
        --header "sessions · $(basename "$dir")  ·  enter resume · ← back" \
        --preview "$self worktree _sesspreview {4}" \
        --preview-window 'right,50%,wrap,border-left' \
        --expect=enter,left) || true

    key=$(printf '%s\n' "$out" | sed -n 1p)
    sel=$(printf '%s\n' "$out" | sed -n 2p)
    if [ -z "$key" ] || [ "$key" = "left" ]; then return 0; fi   # esc / ← -> back
    id2=$(printf '%s' "$sel" | cut -f3)
    [ -n "$id2" ] || return 0

    command -v claude >/dev/null 2>&1 || { echo "claude not found in PATH."; return 0; }
    # Prefer handing cd + launch back to the zsh wrapper: it runs 'builtin cd' in
    # the user's real shell — so the shell re-emits its cwd (OSC 7) and Herdr's
    # sidebar path follows into the worktree — before starting claude. execing
    # claude here instead resumes in the right dir but leaves the parent shell
    # (and thus Herdr's path display) pointing at the old cwd. Needs JT_ARGS_FILE
    # so the wrapper passes '--resume <id>'; without it, deferring would launch a
    # fresh claude, so fall back to the direct exec. exit (not return) so jt fully
    # hands off — a return would bounce back into the dashboard loop.
    if [ -n "${JT_AGENT_FILE:-}" ] && [ -n "${JT_ARGS_FILE:-}" ]; then
        [ -n "${JT_CD_FILE:-}" ] && printf '%s\n' "$dir" > "$JT_CD_FILE"
        printf '%s\n' claude > "$JT_AGENT_FILE"
        printf '%s\n%s\n' --resume "$id2" > "$JT_ARGS_FILE"
        exit 0
    fi
    # Fallback (no wrapper): cd + exec directly. Lands back via JT_CD_FILE.
    [ -n "${JT_CD_FILE:-}" ] && printf '%s\n' "$dir" > "$JT_CD_FILE"
    cd "$dir"
    exec claude --resume "$id2"
}

cmd_worktree_ui() {
    if ! command -v fzf >/dev/null 2>&1 || [ ! -t 1 ]; then
        cmd_worktree_list; return
    fi
    local self; self=$(command -v jt 2>/dev/null) || true
    [ -x "$self" ] || self="$0"

    # Build the (network-backed) feed once, then loop over the cached copy.
    # Drilling into sessions and coming back reuses this file — no rebuild — so
    # the redraw is instant. 'Ctrl-X' remove rewrites the file in place (its
    # +reload runs _fzffeed, which tees back into the cache), so a removed
    # worktree is gone on the next redraw without a full recompute here.
    local cache; cache="$(_wt_feed_cache)"
    _wt_fzf_feed > "$cache"

    # Verbs are Ctrl-chords (never collide with type-to-filter, unlike bare
    # letters, and don't emit stray chars like Alt does under WSL/Windows
    # terminals). Self-contained actions (zed/copy/PR/remove/refresh) run inside
    # fzf via execute*/reload; the ones that hand off the parent shell (cd,
    # claude, new) or open a sub-picker (sessions) exit via --expect. Tab marks
    # rows (--multi); Ctrl-X removes every marked row (or the highlighted one).
    local out key sel kind dir branch
    while :; do
        out=$(fzf --ansi --delimiter=$'\t' --with-nth=1 \
            --reverse --height=100% --no-sort --multi --marker='✓' \
            --header 'type to filter · ↑↓ move · TAB mark · ENTER cd · Ctrl-O claude · Ctrl-E zed
→ sessions · Ctrl-X remove · Ctrl-Y copy · Ctrl-P PR · Ctrl-T new · Ctrl-R refresh · ESC quit' \
            --preview "$self worktree _preview {3} {5} {6} {7}" \
            --preview-window 'right,46%,wrap,border-left' \
            --bind "ctrl-e:execute-silent($self worktree _zed {3})" \
            --bind "ctrl-y:execute-silent($self worktree _copy {3})" \
            --bind "ctrl-p:execute-silent($self worktree _prweb {4})" \
            --bind "ctrl-x:execute($self worktree _rmmulti {+3})+reload($self worktree _fzffeed)" \
            --bind "ctrl-r:reload($self worktree _fzffeed)" \
            --expect=enter,ctrl-o,ctrl-t,right < "$cache") || true

        key=$(printf '%s\n' "$out" | sed -n 1p)
        sel=$(printf '%s\n' "$out" | sed -n 2p)     # first marked row, else current
        [ -z "$key" ] && return 0                   # esc / ctrl-c

        if [ "$key" = "ctrl-t" ]; then cmd_worktree_new; return; fi

        kind=$(printf '%s' "$sel" | cut -f2)
        dir=$(printf '%s' "$sel" | cut -f3)
        branch=$(printf '%s' "$sel" | cut -f4)
        [ "$kind" = "row" ] || continue             # day header -> reopen (cached)

        case "$key" in
            right)                                  # drill into Claude sessions
                cmd_worktree_sessions "$dir"; continue ;;   # back -> reuse cache
            enter)                                  # cd the parent shell in
                if [ -n "${JT_CD_FILE:-}" ]; then printf '%s\n' "$dir" > "$JT_CD_FILE"; return; fi
                cd "$dir"; exec "$SHELL" ;;
            ctrl-o)                                 # cd + launch claude
                if [ -n "${JT_AGENT_FILE:-}" ]; then
                    [ -n "${JT_CD_FILE:-}" ] && printf '%s\n' "$dir" > "$JT_CD_FILE"
                    printf '%s\n' claude > "$JT_AGENT_FILE"
                    return
                fi
                cd "$dir"; exec_agent claude ;;
        esac
    done
}

cmd_worktree_remove() {
    local branch="${1:-}"
    if [ -z "$branch" ]; then
        local pick
        pick="$(worktrees_tsv managed | pick_line "remove> ")" || { echo "Aborted."; exit 0; }
        branch="$(printf '%s' "$pick" | cut -f1)"
    fi
    [ -z "$branch" ] && { echo "Usage: jt worktree remove <branch>"; exit 1; }
    local worktree_dir; worktree_dir="$(wt_dir "$branch")"

    if [ ! -d "$worktree_dir" ]; then
        echo "No worktree at $worktree_dir"
        exit 1
    fi

    read -rp "Remove worktree at $worktree_dir? [y/N] " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        git -C "$REPO" worktree remove "$worktree_dir"
        git -C "$REPO" branch -d "$branch" 2>/dev/null && echo "Deleted branch: $branch" || true
        echo "Removed worktree: $worktree_dir"
    fi
}

cmd_worktree_cleanup() {
    echo "Fetching origin --prune..."
    git -C "$REPO" fetch origin --prune --quiet

    local -a clean_branches=() clean_dirs=() clean_reasons=()

    while IFS=$'\t' read -r dir branch; do
        [ -z "$branch" ] && continue
        [ "$branch" = "main" ] && continue
        # Safety: only touch worktrees inside $WORKTREES
        [[ "$dir" == "$WORKTREES"/* ]] || continue

        local upstream reason=""
        upstream=$(git -C "$REPO" for-each-ref --format='%(upstream:short)' "refs/heads/$branch" 2>/dev/null || true)
        # Never sweep a worktree whose branch never had a remote branch (never pushed):
        # no upstream configured and no matching remote-tracking ref. These hold the only
        # copy of unpushed/uncommitted local work, so they must be removed deliberately
        # (jt worktree remove / nuke), never by the automatic cleanup.
        if [ -z "$upstream" ] && ! git -C "$REPO" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
            continue
        fi
        if [ -n "$upstream" ] && ! git -C "$REPO" show-ref --verify --quiet "refs/remotes/$upstream"; then
            reason="remote branch deleted"
        elif git -C "$REPO" merge-base --is-ancestor "$branch" origin/main 2>/dev/null; then
            reason="merged into main"
        else
            continue
        fi

        clean_branches+=("$branch")
        clean_dirs+=("$dir")
        clean_reasons+=("$reason")
    done < <(git -C "$REPO" worktree list --porcelain | awk '
        /^worktree / { d=substr($0, 10) }
        /^branch /   { b=$2; sub("refs/heads/", "", b); printf "%s\t%s\n", d, b }
    ')

    if [ ${#clean_branches[@]} -eq 0 ]; then
        echo "Nothing to clean up."
        git -C "$REPO" worktree prune
        return 0
    fi

    echo ""
    echo "Cleanable worktrees (${#clean_branches[@]}):"
    local i
    for i in "${!clean_branches[@]}"; do
        printf "  %-48s  (%s)\n" "${clean_branches[$i]}" "${clean_reasons[$i]}"
    done
    echo ""
    read -rp "Remove all ${#clean_branches[@]}? [y/N] " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { echo "Aborted."; return 0; }

    for i in "${!clean_branches[@]}"; do
        local b="${clean_branches[$i]}" d="${clean_dirs[$i]}"
        if git -C "$REPO" worktree remove "$d" 2>/dev/null \
            || git -C "$REPO" worktree remove --force "$d" 2>/dev/null; then
            git -C "$REPO" branch -D "$b" >/dev/null 2>&1 || true
            echo "  removed $b"
        else
            echo "  ! failed to remove $b ($d)"
        fi
    done
    git -C "$REPO" worktree prune
    echo "Done."
}

cmd_worktree_nuke() {
    local branch="${1:-}"
    if [ -z "$branch" ]; then
        local pick
        pick="$(worktrees_tsv managed | pick_line "nuke> ")" || { echo "Aborted."; exit 0; }
        branch="$(printf '%s' "$pick" | cut -f1)"
    fi
    [ -z "$branch" ] && { echo "Usage: jt worktree nuke <branch>"; exit 1; }
    local worktree_dir; worktree_dir="$(wt_dir "$branch")"

    local has_worktree=0 has_local=0 has_remote=0
    [ -d "$worktree_dir" ] && has_worktree=1
    git -C "$REPO" show-ref --verify --quiet "refs/heads/$branch" && has_local=1
    git -C "$REPO" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1 && has_remote=1

    if [ "$has_worktree" -eq 0 ] && [ "$has_local" -eq 0 ] && [ "$has_remote" -eq 0 ]; then
        echo "Nothing to nuke: no worktree, local branch, or remote branch for '$branch'."
        exit 1
    fi

    echo "About to NUKE '$branch':"
    [ "$has_worktree" -eq 1 ] && echo "  - worktree:      $worktree_dir (force, drops uncommitted changes)"
    [ "$has_local" -eq 1 ]    && echo "  - local branch:  $branch"
    [ "$has_remote" -eq 1 ]   && echo "  - remote branch: origin/$branch"

    read -rp "Continue? [y/N] " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }

    if [ "$has_worktree" -eq 1 ]; then
        git -C "$REPO" worktree remove --force "$worktree_dir" && echo "Removed worktree: $worktree_dir"
    fi
    if [ "$has_local" -eq 1 ]; then
        git -C "$REPO" branch -D "$branch" >/dev/null && echo "Deleted local branch: $branch"
    fi
    if [ "$has_remote" -eq 1 ]; then
        git -C "$REPO" push origin --delete "$branch" && echo "Deleted remote branch: origin/$branch"
    fi
    git -C "$REPO" worktree prune
}

cmd_worktree_setup() {
    local dir="${1:-}"
    [ -z "$dir" ] && { dir="$(cwd_or_die)" || exit 1; }

    if [ ! -d "$dir" ]; then
        # Try as a branch name
        if [ -d "$(wt_dir "$dir")" ]; then
            dir="$(wt_dir "$dir")"
        else
            echo "Error: no directory at $dir"
            exit 1
        fi
    fi

    setup_worktree "$dir"
    echo ""
    echo "Done. Worktree ready at:"
    echo "  $dir"
}

cmd_worktree_edit() {
    local branch="${1:-}"
    local dir

    if [ -z "$branch" ]; then
        dir="$(cwd_or_die)" || exit 1
    else
        dir="$(wt_dir "$branch")"
    fi

    if [ ! -d "$dir" ]; then
        echo "Error: no directory at $dir"
        exit 1
    fi

    local zed_cmd
    zed_cmd="$(find_zed)" || { echo "Error: zed/zeditor not found"; exit 1; }
    "$zed_cmd" "$dir"
}

# ─── Issue commands ────────────────────────────────────────

# Derive a branch name "<prefix>/<number>-<slug>" from an issue. Prefix comes
# from the GitHub issue type, falling back to a conventional title prefix
# (feat:/fix:/chore(scope):), else "feat".
issue_branch_name() {
    local number="$1" title="$2" itype="$3"
    local key="" prefix slug
    local conv_re='^([a-zA-Z]+)(\([^)]*\))?:'

    if [ -n "$itype" ]; then
        key="$itype"
    elif [[ "$title" =~ $conv_re ]]; then
        key="${BASH_REMATCH[1]}"
    fi

    case "$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')" in
        bug|fix)                                                  prefix="fix" ;;
        task|chore|"tech debt"|techdebt|docs|refactor|test|perf|ci|build|style) prefix="chore" ;;
        *)                                                        prefix="feat" ;;
    esac

    # Slug from the title: drop a leading conventional prefix, lowercase,
    # collapse non-alphanumerics to '-', trim, cap length.
    slug="$(printf '%s' "$title" \
        | sed -E 's/^[a-zA-Z]+(\([^)]*\))?:[[:space:]]*//' \
        | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
        | cut -c1-50 | sed -E 's/-+$//')"
    [ -z "$slug" ] && slug="issue"

    printf '%s/%s-%s' "$prefix" "$number" "$slug"
}

cmd_issue_start() {
    local url="${1:-}"

    command -v gh >/dev/null 2>&1 || { echo "Error: gh (GitHub CLI) is required for 'jt issue'."; exit 1; }

    # No argument: fuzzy-pick from the repo's open issues.
    if [ -z "$url" ]; then
        echo "Fetching open issues from Companion-energy/jolteon..." >&2
        local pick
        pick="$(gh issue list --repo Companion-energy/jolteon --limit 100 --state open \
            --json number,title --jq '.[] | "#\(.number)\t\(.title)"' \
            | pick_line "issue> ")" || { echo "Aborted."; exit 0; }
        url="$(printf '%s' "$pick" | sed -E 's/^#([0-9]+).*/\1/')"
        [ -z "$url" ] && { echo "No selection."; exit 1; }
    fi

    # Accept a full issue URL or a bare number (defaults to the jolteon repo).
    local owner repo number
    if [[ "$url" =~ github\.com/([^/]+)/([^/]+)/issues/([0-9]+) ]]; then
        owner="${BASH_REMATCH[1]}"; repo="${BASH_REMATCH[2]}"; number="${BASH_REMATCH[3]}"
    elif [[ "$url" =~ ^[0-9]+$ ]]; then
        owner="Companion-energy"; repo="jolteon"; number="$url"
        url="https://github.com/$owner/$repo/issues/$number"
    else
        echo "Error: not a GitHub issue URL or number: $url"
        echo "Expected: https://github.com/<owner>/<repo>/issues/<number>"
        exit 1
    fi

    echo "Fetching issue #$number from $owner/$repo..."
    local meta title itype
    meta=$(gh api graphql -f query="{ repository(owner: \"$owner\", name: \"$repo\") { issue(number: $number) { title issueType { name } } } }" \
        --jq '.data.repository.issue | "\(.issueType.name // "")\t\(.title // "")"' 2>/dev/null) \
        || { echo "Error: could not fetch issue #$number from $owner/$repo (does it exist? are you authenticated with gh?)."; exit 1; }
    itype="${meta%%$'\t'*}"
    title="${meta#*$'\t'}"
    [ -z "$title" ] && { echo "Error: issue #$number has no title (not found?)."; exit 1; }

    local branch
    branch="$(issue_branch_name "$number" "$title" "$itype")"

    echo "Issue:   #$number  $title"
    echo "Branch:  $branch"

    local preamble
    preamble="You're starting work on GitHub issue #$number: \"$title\".
Issue: $url

Before making changes, fetch the issue for full context — e.g. \`gh issue view $url\` — then review the relevant code and propose an approach."

    cmd_worktree_create "$branch" "$preamble"
}

# ─── PR commands ───────────────────────────────────────────

cmd_pr_review() {
    local url="${1:-}"

    command -v gh >/dev/null 2>&1 || { echo "Error: gh (GitHub CLI) is required for 'jt pr'."; exit 1; }

    # No argument: fuzzy-pick from the repo's open PRs.
    if [ -z "$url" ]; then
        echo "Fetching open PRs from Companion-energy/jolteon..." >&2
        local pick
        pick="$(gh pr list --repo Companion-energy/jolteon --limit 100 \
            --json number,title,headRefName,author \
            --jq '.[] | "#\(.number)\t\(.title)\t\(.headRefName)\t@\(.author.login)"' \
            | pick_line "PR> ")" || { echo "Aborted."; exit 0; }
        url="$(printf '%s' "$pick" | sed -E 's/^#([0-9]+).*/\1/')"
        [ -z "$url" ] && { echo "No selection."; exit 1; }
    fi

    # Accept a full PR URL or a bare number (defaults to the jolteon repo).
    local owner repo number
    if [[ "$url" =~ github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
        owner="${BASH_REMATCH[1]}"; repo="${BASH_REMATCH[2]}"; number="${BASH_REMATCH[3]}"
    elif [[ "$url" =~ ^[0-9]+$ ]]; then
        owner="Companion-energy"; repo="jolteon"; number="$url"
        url="https://github.com/$owner/$repo/pull/$number"
    else
        echo "Error: not a GitHub PR URL or number: $url"
        echo "Expected: https://github.com/<owner>/<repo>/pull/<number>"
        exit 1
    fi

    echo "Fetching PR #$number from $owner/$repo..."
    local meta branch title
    # Some mise-managed gh wrappers print a tool-update notice to stdout before
    # gh's actual output. Keep only the final, tab-separated record produced by
    # the jq expression so that notice cannot become part of the branch name.
    meta=$(gh pr view "$number" --repo "$owner/$repo" --json headRefName,title \
        --jq '"\(.headRefName // "")\t\(.title // "")"' 2>/dev/null | tail -n 1) \
        || { echo "Error: could not fetch PR #$number from $owner/$repo (does it exist? are you authenticated with gh?)."; exit 1; }
    branch="${meta%%$'\t'*}"
    title="${meta#*$'\t'}"
    [ -z "$branch" ] && { echo "Error: PR #$number has no head branch (cross-fork PRs aren't supported)."; exit 1; }

    echo "PR:      #$number  $title"
    echo "Branch:  $branch"

    # Invoke the /code-review skill directly — the worktree has the PR branch
    # checked out, so the skill reviews the PR's diff against main.
    local preamble="/code-review"

    cmd_worktree_checkout "$branch" "$preamble"
}

# ─── App commands ──────────────────────────────────────────

cmd_app_run() {
    parse_env_flag "$@"
    local env="$ENV_CHOICE" run_agent=0 _a
    if [ ${#REMAINING_ARGS[@]} -gt 0 ]; then
        for _a in "${REMAINING_ARGS[@]}"; do
            case "$_a" in
                --agent) run_agent=1 ;;
                *)
                    echo "Unknown argument: $_a"
                    echo "Usage: jt app run [--local|--dev|--fork|--prd-fork] [--agent] [--as <persona>]"
                    exit 1
                    ;;
            esac
        done
    fi

    if [ -z "$env" ]; then
        env="$(prompt_env dev)"
    fi

    # Production data comes from a fork. --prd sat on the read-only role, so nothing that
    # writes could run there; a fork takes writes and is thrown away afterwards.
    if [ "$env" = "prd" ]; then
        echo "Error: 'jt app run --prd' is gone. Production data runs on a Tiger fork:" >&2
        echo "       'jt app run --prd-fork --as root [--agent]'." >&2
        exit 1
    fi

    # A fork of prd is entered through the auth bypass for now. Its users carry production
    # WorkOS ids, so a real login would have to be a production one, and that is only safe
    # once dashboard-api can be kept from writing to production WorkOS — which it cannot yet.
    # Said up front, before a fork is taken for nothing.
    if [ "$env" = "prd_fork" ] && [ -z "${PERSONA:-}" ]; then
        echo "Error: --prd-fork needs a persona for now: --as root (or customer/ivarem, see" >&2
        echo "       resolve_persona in ~/.config/jt/environments.sh)." >&2
        exit 1
    fi

    # Refuse rather than clobber: the implicit stop below kills by process group, so a
    # server belonging to another worktree would go down without being asked.
    local foreign; foreign="$(app_ports_owned_elsewhere)"
    if [ -n "$foreign" ]; then
        echo "Refusing to start: app ports are held by another worktree." >&2
        printf '%s\n' "$foreign" | while IFS='|' read -r _p _pid _cwd; do
            printf '  :%-5s pid=%-8s %s\n' "$_p" "$_pid" "$_cwd" >&2
        done
        echo "" >&2
        echo "'jt app run' stops whatever holds these ports first, which would kill that" >&2
        echo "session's services with no prompt. Check with whoever owns that worktree." >&2
        echo "If it is genuinely abandoned, 'jt app stop' still stops it explicitly." >&2
        exit 1
    fi

    # Stop any running services first
    cmd_app_stop 2>/dev/null || true

    local env_file="$HOME/.config/jt/environments.sh"
    if [ ! -f "$env_file" ]; then
        echo "Error: missing $env_file"
        echo ""
        echo "Create it with env_dev() and env_prd() shell functions (both forks come from the Tiger CLI)."
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$env_file"

    # Every value parse_env_flag can produce needs a branch here. A missing one is silent:
    # no env_* runs, PG_* stays unset, and the first thing to read it fails somewhere far
    # from the cause. The `*)` arm makes that loud instead.
    case "$env" in
        local)    env_local || exit 1 ;;
        dev)      env_dev ;;
        # Neither fork is an env_* function: a fork's host AND port change every time one
        # is taken, so both are resolved from the Tiger CLI rather than maintained by hand.
        # fork_env also sets AGENT_PG_*, which is why there is no agent_env_*fork either —
        # a pair has to come from ONE environment, so one call resolves both halves.
        fork)     fork_env dev || exit 1 ;;
        prd_fork) fork_env prd || exit 1 ;;
        *)        echo "Error: no env_$env in $env_file." >&2; exit 1 ;;
    esac

    # Persona override (auth bypass) — opt-in, except on --prd-fork (above), and for when nobody
    # can type a password (an agent driving the browser). Otherwise you sign in for real.
    # resolve_persona (in
    # environments.sh) errors on an undefined (env, persona) combo — abort rather than start as
    # the wrong / a non-existent user. --local resolves through the dev rows: its seed carries
    # dev's own identities.
    if [ -n "${PERSONA:-}" ]; then
        local persona_env="$env"
        [ "$env" = "local" ] && persona_env="dev"
        resolve_persona "$persona_env" "$PERSONA" || {
            echo "Aborting: persona '$PERSONA' is not defined for env '$persona_env' in $env_file."
            exit 1
        }
    fi

    # Whenever the bypass is on, pin COMPANION_ENV=local so the backend's DISABLE_AUTH gate
    # activates and its startup assert is satisfied, independent of which DB the env selected.
    if [ "${DISABLE_AUTH_RAW:-}" = "true" ]; then
        export COMPANION_ENV=local
    fi

    echo ""
    echo "Starting services..."
    echo "  Frontend: http://localhost:5173"
    echo "  Backend:  http://localhost:8000"
    if [ "$run_agent" -eq 1 ]; then
        echo "  Analytics API:  http://localhost:8122  (DB: $env)"
        echo "  Analytics MCP:  http://localhost:8003/mcp"
        echo "  Management MCP: http://localhost:8002/mcp  (-> local backend)"
        echo "  Agent service:  http://localhost:8140"
        echo "  LiteLLM:        http://localhost:4000  (local gateway)"
    fi
    echo ""
    if [ "${DISABLE_AUTH_RAW:-}" = "true" ]; then
        echo "Signed in as persona '$PERSONA' (auth bypass). The assistant ignores the persona"
        echo "and acts as a fixed root admin."
    else
        echo "Sign in with your dev account."
    fi
    echo "Viewing from another machine (e.g. your Mac)? Run 'jt app forward' there"
    echo "to tunnel these ports, then open the URLs above."
    echo ""

    # Disarm the trap before 'kill 0': that signals our own process group with
    # SIGTERM, and a still-armed TERM trap would re-run this handler, re-signal,
    # and loop — flooding the terminal with "Stopping services...".
    trap 'trap - INT TERM; echo ""; echo "Stopping services..."; kill 0' INT TERM

    # dashboard-api publishes its org/user/membership snapshot to the Service Bus its .env
    # names — dev's — and agent-service in dev mirrors whatever arrives. From any database
    # but dev's own that pushes foreign identities (prd's, a fork's, the seed's) into dev's
    # assistant, so only --dev keeps it. Nothing else in dashboard-api uses Service Bus.
    local -a api_env=()
    [ "$env" != "dev" ] && api_env+=(SERVICE_BUS_CONNECTION_STRING=)
    (cd services/dashboard-api 2>/dev/null || cd "$REPO/services/dashboard-api"
     env "${api_env[@]}" uv run uvicorn app.main:app --host 0.0.0.0 --port 8000) &

    local vite_env=""
    if [ "${DISABLE_AUTH_RAW:-}" = "true" ]; then
        # Pass both: VITE_DISABLE_AUTH activates the frontend bypass, and
        # VITE_COMPANION_ENV=local makes env.ts select localConfig explicitly
        # (the only config object carrying DISABLE_AUTH) instead of relying on
        # the unset-fallback. Setting only one of the pair causes a sign-out loop.
        vite_env="VITE_DISABLE_AUTH=true VITE_COMPANION_ENV=local"
    fi
    (cd services/frontend 2>/dev/null || cd "$REPO/services/frontend"
     use_pinned_node "$PWD/../.."
     env $vite_env npm run dev) &

    # --agent: also bring up the agent-workflow stack. analytics-api reads the
    # SAME PG_*/DISABLE_AUTH_RAW/AUTH_*_OVERWRITE this function already exported,
    # so the env flag (and any --as persona) points it at the SAME dev/prd/local
    # database as the backend — "the underlying database", not a local one.
    # analytics-mcp queries that local analytics-api; agent-service (its own
    # docker Postgres + .env) calls the MCP. All join this process group, so the
    # trap's 'kill 0' stops them on Ctrl+C too.
    if [ "$run_agent" -eq 1 ]; then
        local agent_dir; agent_dir="$(agent_service_dir)"
        if [ ! -d "$agent_dir" ]; then
            echo "Warning: $agent_dir not found — skipping the agent stack"
            echo "(the agent-service may still be on a feature branch)."
        else
            agent_ensure_env "$agent_dir"

            # Which database agent-service talks to, per --dev/--fork/--prd. Defined in
            # environments.sh as agent_env_<env>, exporting AGENT_PG_*. Namespaced on
            # purpose: agent-service owns a SEPARATE Postgres but reads the same PG_*
            # variable names as dashboard-api, so inheriting the Jolteon exports points it
            # at the wrong database and it fails looking for its `agent` schema there.
            # Either fork already has its AGENT_PG_* set: fork_env resolved BOTH halves of
            # the pair from the Tiger CLI, which is the point — the two forks have to come
            # from the same environment, so one function resolves both rather than two
            # hand-maintained ones that can drift apart.
            #
            # --local keeps it on this machine, beside its seeded Jolteon database (see
            # "Local databases"), and wins over any agent_env_local in environments.sh.
            if [ "$env" = "fork" ] || [ "$env" = "prd_fork" ]; then
                :
            elif [ "$env" = "local" ]; then
                agent_env_docker "$LOCAL_AGENT_DB"
            elif command -v "agent_env_$env" >/dev/null 2>&1; then
                "agent_env_$env"
            else
                echo "Error: no agent_env_$env in $env_file." >&2
                exit 1
            fi

            # An EMPTY host means agent-service falls back to its DATABASE_URL (the docker
            # Postgres); a local one names that server explicitly. A still-templated
            # REPLACE_* host is a genuine gap and stops the stack.
            case "${AGENT_PG_HOST:-}" in
                REPLACE_*)
                    echo ""
                    echo "⚠  Skipping the agent stack: agent_env_$env still has REPLACE_* placeholders."
                    echo "   Fill them in $env_file, or set AGENT_PG_HOST=\"\" to use the local"
                    echo "   docker database instead."
                    echo ""
                    run_agent=0
                    ;;
                ""|localhost|127.0.0.1)
                    # Empty OR an explicitly-local host: both mean the docker Postgres,
                    # so both need it up. agent_env_dev names it explicitly rather than
                    # leaving the host empty, because agent-service REFUSES TO START with
                    # DISABLE_AUTH=false and no PG_HOST — which is what made `--agent`
                    # without `--as` die silently on 8140.
                    agent_ensure_db "$agent_dir"
                    ;;
            esac

            # analytics-api requires WORKOS_CLIENT_ID/SECRET with no defaults. Lift them
            # from dashboard-api's .env instead of keeping a second copy in
            # services/analytics-api/.env — one source, nothing to keep in step.
            agent_export_workos

            # Resolved before anything starts so both the service and the gateway agree on
            # the URL and the shared secret.
            local agent_gateway_url agent_gateway_key
            agent_gateway_env

            # Track the same bypass switch as the backend/frontend: analytics-api
            # only bypasses auth when DISABLE_AUTH_RAW is on (a persona, or --prd),
            # so the MCP + agent-service must match — else analytics-api rejects
            # the MCP's forwarded token and every data query fails. With --as the
            # whole chain is bypassed; without it, all use real WorkOS auth.
            local svc_disable_auth="${DISABLE_AUTH_RAW:-false}"

            # analytics-api loads its OWN .env and has required WorkOS creds (no
            # defaults), so it crashes on boot without one. Warn early rather than
            # letting the launch fail cryptically. (analytics-mcp boots on defaults
            # + the inline vars below; agent-service's .env was seeded above.)
            local analytics_env
            analytics_env="$(cd services/analytics-api 2>/dev/null && pwd)/.env" \
                || analytics_env="$REPO/services/analytics-api/.env"
            if [ ! -f "$analytics_env" ] && [ -z "${WORKOS_CLIENT_ID:-}" ]; then
                echo ""
                echo "⚠  analytics-api needs WorkOS creds and none were found."
                echo "   Set WORKOS_CLIENT_ID / WORKOS_CLIENT_SECRET in"
                echo "   services/dashboard-api/.env (jt lifts them from there), or create"
                echo "   $analytics_env."
                echo ""
            fi

            (cd services/analytics-api 2>/dev/null || cd "$REPO/services/analytics-api"
             uv run uvicorn app.main:app --port 8122) &

            (cd services/analytics-mcp 2>/dev/null || cd "$REPO/services/analytics-mcp"
             env ANALYTICS_API_BASE_URL="http://localhost:8122" \
                 DISABLE_AUTH="$svc_disable_auth" \
                 COMPANION_ENV="local" \
                 uv run uvicorn app.main:app --port 8003) &

            # management-mcp against THIS dashboard-api, not a deployed one: its tools are
            # dashboard-api's own routes, so this is what exercises a route change end to
            # end. Under the bypass it forwards `dev-token`, which the bypassed backend ignores.
            local mcp_dir api_dir
            mcp_dir="$(cd services/management-mcp 2>/dev/null && pwd)" || mcp_dir="$REPO/services/management-mcp"
            api_dir="$(cd services/dashboard-api 2>/dev/null && pwd)" || api_dir="$REPO/services/dashboard-api"
            if mcp_ensure_spec "$mcp_dir" "$api_dir"; then
                (cd "$mcp_dir"
                 env DASHBOARD_API_BASE_URL="http://localhost:8000" \
                     DISABLE_AUTH="$svc_disable_auth" \
                     MCP_BASE_URL="http://localhost:8002" \
                     COMPANION_ENV="local" \
                     uv run uvicorn app.main:app --port 8002) &
            fi

            # Always the local backend and the local frontend's origin, whatever the .env says:
            # this stack exists so every hop is the code in this checkout. Intake writes are
            # allowed explicitly because every backend here is writable, and a worktree whose
            # .env is the agent-local-prod store's would otherwise inherit its write guard.
            local -a agent_env=(
                ANALYTICS_MCP_URL="http://localhost:8003/mcp"
                DASHBOARD_API_URL="http://localhost:8000"
                DASHBOARD_API_WRITES_DISABLED="false"
                CORS_ORIGINS="http://localhost:5173"
                COMPANION_ENV="local"
                DISABLE_AUTH="$svc_disable_auth"
                LITELLM_BASE_URL="$agent_gateway_url"
                LITELLM_API_KEY="$agent_gateway_key"
                PG_HOST="${AGENT_PG_HOST:-}"
                PG_PORT="${AGENT_PG_PORT:-5432}"
                PG_USER="${AGENT_PG_USER:-}"
                PG_PASSWORD="${AGENT_PG_PASSWORD:-}"
                PG_DATABASE="${AGENT_PG_DATABASE:-tsdb}"
                PG_SSLMODE="${AGENT_PG_SSLMODE:-require}"
            )
            # A local agent database keeps attachment bytes local too (Azurite, from
            # agent-service's own compose file), so rows and blobs always live together.
            local agent_db_local=0 azurite=""
            case "${AGENT_PG_HOST:-}" in ""|localhost|127.0.0.1) agent_db_local=1 ;; esac
            if [ "$agent_db_local" -eq 1 ] && [ -f "$agent_dir/.env.example" ]; then
                azurite="$(grep -m1 '^STORAGE_CONNECTION_STRING=.*devstoreaccount1' "$agent_dir/.env.example" || true)"
            fi
            [ -n "$azurite" ] && agent_env+=("$azurite")

            (cd "$agent_dir"
             env "${agent_env[@]}" uv run uvicorn app.main:app --port 8140) &

            # Catch the split-brain that cost a long debugging session: the agent DB on
            # dev while attachment BYTES still go to the Azurite emulator. Uploads appear
            # to work, but every agent.attachment row written to dev names a blob_path
            # that resolves on this laptop and nowhere else.
            if [ "$agent_db_local" -eq 0 ] && [ -f "$agent_dir/.env" ] \
               && grep -q 'devstoreaccount1' "$agent_dir/.env" 2>/dev/null; then
                echo ""
                echo "⚠  Agent DB is remote ($AGENT_PG_HOST) but attachments still go to"
                echo "   Azurite (devstoreaccount1). Rows will land in that database naming"
                echo "   blobs only this machine can serve. Point STORAGE_CONNECTION_STRING in"
                echo "   $agent_dir/.env at the dev account:"
                echo "     az storage account show-connection-string \\"
                echo "       --name stagentuploadsdevweu --resource-group rg-companion-energy-dev-weu"
                echo ""
            fi

            # Invoice intake needs a THIRD storage account, read only by dashboard-api's
            # BlobStorageService and defaulting to None — so a missing value shows up as a
            # 500 from /v2/customers/{id}/invoices and a 502 on the upload, nowhere near
            # the actual cause.
            local dash_env="$REPO/services/dashboard-api/.env"
            [ -f "services/dashboard-api/.env" ] && dash_env="services/dashboard-api/.env"
            if [ -f "$dash_env" ] && ! grep -q '^CUSTOMER_DATA_STORAGE_CONNECTION_STRING=' "$dash_env"; then
                echo ""
                echo "⚠  No CUSTOMER_DATA_STORAGE_CONNECTION_STRING in $dash_env."
                echo "   Invoice intake will 500 ('Storage connection string is not set') and"
                echo "   the reconciler upload will 502. Add it from stcustomerdatadevweu."
                echo ""
            fi

            # The invoice reconciliation worker, on the SAME database as the backend. It is
            # part of the agent stack rather than its own flag because after the hand-off
            # tool landed the assistant can start a check but nothing would run it — a chat
            # that queues invoices into an empty pipeline looks broken in a way no error
            # explains. Costs nothing when idle: it polls, finds no invoices, and sleeps.
            invoice_worker_start "$(invoice_service_dir)" "$env"

            if [ -f "$LITELLM_CONFIG" ]; then
                agent_litellm_start "$agent_dir"
            else
                echo ""
                echo "⚠  No LiteLLM config at $LITELLM_CONFIG — skipping the gateway."
                echo "   agent-service will use the direct Anthropic client, which cannot"
                echo "   serve dev's gateway-named catalog: chat turns will fail to resolve"
                echo "   a model. Uploads and history still work."
                echo ""
            fi
        fi
    fi

    echo "Services started. Press Ctrl+C to stop."
    echo ""
    wait
}

# Which of the app ports are held by a process from a DIFFERENT worktree.
# Prints "port|pid|cwd" per offender; empty output means the ports are ours or free.
#
# Exists because 'jt app run' stops whatever holds these ports before starting, which
# kills another session's servers by process group with no prompt. On a machine running
# several worktrees at once that is a silent clobber of someone else's work — a real
# near-miss, not a hypothetical.
app_ports_owned_elsewhere() {
    local here port pids pid cwd
    here="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    for port in 5173 8000 8002 8003 8122 8140 4000; do
            # -sTCP:LISTEN, matching cmd_app_stop: a bare lsof also matches CLIENT
            # sockets, so a browser tab pointed at 5173 would read as owning it.
            pids=$(lsof -ti :"$port" -sTCP:LISTEN 2>/dev/null || true)
        for pid in $pids; do
            cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || continue
            case "$cwd" in
                "$here"|"$here"/*) ;;
                *) printf '%s|%s|%s\n' "$port" "$pid" "$cwd" ;;
            esac
        done
    done
}

cmd_app_stop() {
    local cur_pgid port pid pgid i pgids=""
    cur_pgid=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')

    # Collect the process GROUPS that own the dev ports, then kill whole groups —
    # not just the port-holding PIDs. 'jt app run' launches everything (uv-run +
    # uvicorn --reload + its worker + vite) in one process group, and the uvicorn
    # --reload supervisor does NOT itself hold the port. Killing only the port
    # holder leaves the supervisor alive to respawn its worker, so the port never
    # frees and the next 'jt app run' can't bind it (the "works on the 2nd try"
    # bug). Killing the group takes the supervisor down too. Skip our own group so
    # we never kill the in-progress 'jt app run' that called this.
    #
    # -sTCP:LISTEN is critical: a bare 'lsof -ti :PORT' matches ANY socket on the
    # port, including CLIENTS connected to it. A browser tab open on
    # localhost:5173 holds an established connection, so it'd be returned here and
    # we'd kill -9 its whole process group — nuking the entire browser. Restrict
    # to listening sockets so we only ever kill the dev servers themselves.
    # 8000/5173 = backend/frontend; 8002/8122/8003/8140/4000 = the '--agent' stack
    # (management-mcp / analytics-api / analytics-mcp / agent-service / local LiteLLM gateway). The
    # agent-service's docker Postgres (5433) and Azurite (10000) are deliberately left
    # up — stop them with 'docker compose down'.
    for port in 8000 5173 8002 8122 8003 8140 4000; do
        for pid in $(lsof -ti :"$port" -sTCP:LISTEN 2>/dev/null); do
            pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')
            [ -n "$pgid" ] && [ "$pgid" != "$cur_pgid" ] && pgids="$pgids $pgid"
        done
    done
    pgids=$(printf '%s\n' $pgids | sort -u)

    if [ -z "$pgids" ]; then
        echo "No services running."
        return 0
    fi

    for pgid in $pgids; do
        kill -9 -"$pgid" 2>/dev/null || true
    done
    echo "Stopped services (backend + frontend + agent stack)"

    # Wait for the kernel to actually release the ports before returning, so the
    # following 'jt app run' binds cleanly.
    for port in 8000 5173 8002 8122 8003 8140 4000; do
        for i in $(seq 1 50); do
            lsof -ti :"$port" -sTCP:LISTEN >/dev/null 2>&1 || break
            sleep 0.1
        done
    done
}

# Open an SSH tunnel to the other machine over Tailscale, so services started
# with 'jt app run' there remain reachable at localhost here. Keeping localhost
# is important: the frontend's local config and WorkOS redirect URI both use it.
# Defaults to the 'desktop' SSH alias; pass --host macbook for the reverse route.
# --env <name> tunnels one `jt env` instead: the same three localhost ports here, each mapped to
# the port that env published over there.
cmd_app_forward() {
    local host="desktop" env_name=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --host)
                [ $# -ge 2 ] && [ -n "$2" ] \
                    || { echo "Error: --host needs an SSH host or alias."; return 1; }
                host="$2"
                shift 2
                ;;
            --env)
                [ $# -ge 2 ] && [ -n "$2" ] \
                    || { echo "Error: --env needs an env name ('jt env list' on the other machine)."; return 1; }
                env_name="$2"
                shift 2
                ;;
            -h|--help)
                echo "Usage: jt app forward [--env <name>] [--host <ssh-host>]"
                echo ""
                echo "Defaults to 'desktop'. Use '--host macbook' for the reverse route."
                return 0
                ;;
            *)
                echo "Unknown argument: $1"
                echo "Usage: jt app forward [--env <name>] [--host <ssh-host>]"
                return 1
                ;;
        esac
    done

    # Where that env published its browser ports, asked of the other machine's own jt. The
    # remote port per local one: the frontend on IPv6 loopback, where vite listens; the backend
    # and agent-service on IPv4.
    local -A remote=([5173]="localhost:5173" [8000]="localhost:8000" [8140]="localhost:8140")
    if [ -n "$env_name" ]; then
        local answer
        answer="$(ssh -o BatchMode=yes "$host" "\$HOME/.local/bin/jt env ports $(printf '%q' "$env_name")" 2>&1)" \
            || { echo "Error: '$host' has no running env '$env_name': $answer"; return 1; }
        local web api agent
        web="$(sed -n 's/.*web=\([0-9]*\).*/\1/p' <<<"$answer")"
        api="$(sed -n 's/.*api=\([0-9]*\).*/\1/p' <<<"$answer")"
        agent="$(sed -n 's/.*agent=\([0-9]*\).*/\1/p' <<<"$answer")"
        [ -n "$web" ] && [ -n "$api" ] && [ -n "$agent" ] \
            || { echo "Error: unexpected answer from '$host': $answer"; return 1; }
        remote=([5173]="[::1]:$web" [8000]="127.0.0.1:$api" [8140]="127.0.0.1:$agent")
    fi

    # 8140 = agent-service ("My Companion" AI assistant). Its own docker Postgres
    # (5433) and the analytics MCP (8003) it calls are server-side only, so only
    # the HTTP port the browser hits needs tunnelling.
    local -a ports=(5173 8000 8140)

    # SSH can't bind a local port that's already taken. Check listening sockets
    # only: an open browser connection is not itself a conflict.
    local -a busy=()
    local p
    for p in "${ports[@]}"; do
        lsof -ti :"$p" -sTCP:LISTEN >/dev/null 2>&1 && busy+=("$p")
    done
    if [ ${#busy[@]} -gt 0 ]; then
        echo "Local app ports already in use: ${busy[*]}"
        local confirm
        while true; do
            if ! read -rp "Stop the local app processes? [Y/n] " confirm; then
                echo ""
                echo "Unable to read confirmation; leaving local processes running."
                return 1
            fi
            case "${confirm:-y}" in
                y|Y|yes|YES|Yes)
                    cmd_app_stop
                    break
                    ;;
                n|N|no|NO|No)
                    echo "Leaving local processes running; forwarding cancelled."
                    return 1
                    ;;
                *) echo "Please answer yes or no." ;;
            esac
        done

        # cmd_app_stop waits for the known app services to release their ports.
        # Check again in case a different process owns one or immediately
        # restarted; SSH would otherwise fail with a less useful bind error.
        busy=()
        for p in "${ports[@]}"; do
            lsof -ti :"$p" -sTCP:LISTEN >/dev/null 2>&1 && busy+=("$p")
        done
        if [ ${#busy[@]} -gt 0 ]; then
            echo "Error: local ports still in use after stopping services: ${busy[*]}"
            return 1
        fi
    fi

    local -a fwd=()
    for p in "${ports[@]}"; do
        fwd+=(-L "$p:${remote[$p]}")
    done

    if [ -n "$env_name" ]; then
        echo "Forwarding env '$env_name' on '$host' to localhost (ports ${ports[*]})."
    else
        echo "Forwarding ports ${ports[*]} from '$host' to localhost."
    fi
    echo "Then open http://localhost:5173"
    echo "Leave this running; press Ctrl+C to stop."
    echo ""
    exec ssh -N \
        -o BatchMode=yes \
        -o ExitOnForwardFailure=yes \
        -o ServerAliveInterval=15 \
        -o ServerAliveCountMax=3 \
        "${fwd[@]}" "$host"
}

# Serve a directory (default: the worktree's root .context folder — plans, docs,
# agent-generated HTML) over HTTP, bound to all interfaces so it's reachable from
# another machine on the tailnet (e.g. open http://pc-seba-1:8090/ on your Mac).
# Static files only, so no SSH tunnel is needed. Pass a dir and/or --port to override.
cmd_docs_serve() {
    local port="8090" dir=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --port) port="${2:-}"; [ -z "$port" ] && { echo "--port needs a value"; exit 1; }; shift 2 ;;
            *)      dir="$1"; shift ;;
        esac
    done

    if [ -z "$dir" ]; then
        local root
        root="$(git rev-parse --show-toplevel 2>/dev/null)" \
            || { echo "Not in a git worktree — pass a directory: jt docs serve <dir>"; exit 1; }
        dir="$root/.context"
    fi
    [ -d "$dir" ] || { echo "Nothing to serve: $dir does not exist"; exit 1; }

    # Free the port so re-running 'jt serve' just works.
    local pids
    pids=$(lsof -ti :"$port" 2>/dev/null || true)
    if [ -n "$pids" ]; then
        echo "$pids" | xargs kill -9 2>/dev/null || true
        sleep 0.3
    fi

    echo "Serving $dir at:"
    echo "  http://pc-seba-1:$port/   <- open this on your Mac (over Tailscale)"
    echo "  http://localhost:$port/   (on this box)"
    echo "Ctrl+C to stop."
    echo ""
    exec python3 -m http.server "$port" --bind 0.0.0.0 --directory "$dir"
}

# ─── Pulse commands ────────────────────────────────────────

# Allow the locally-run frontend to fetch pulse-report blobs from the dev
# Storage account in the browser.
#
# Why this is needed: dashboard-api hands the UI a *SAS URL* pointing straight
# at https://<account>.blob.core.windows.net/..., and the browser fetches it
# directly. That cross-origin request is blocked unless the Storage account
# carries a CORS rule for the frontend's origin — so a valid SAS URL still
# renders as an empty/broken report locally until this runs.
#
# Idempotent + self-contained: skips when a rule already allows the origin, and
# reuses COMPANION_STORAGE_CONNECTION_STRING from services/dashboard-api/.env
# (the same secret the backend authenticates with — mirrors how 'jt mcp run'
# sources dashboard-api creds), so no separate 'az login' is required.
cmd_pulse_cors() {
    local origin="${1:-http://localhost:5173}"

    command -v az >/dev/null 2>&1 || {
        echo "Error: the Azure CLI ('az') is required for 'jt pulse cors'."
        exit 1
    }

    # Prefer the current worktree's .env, fall back to the main checkout.
    local dashboard_env
    dashboard_env="$(cd services/dashboard-api 2>/dev/null && pwd)/.env" \
        || dashboard_env="$REPO/services/dashboard-api/.env"
    if [ ! -f "$dashboard_env" ]; then
        echo "Error: $dashboard_env not found — can't read the storage connection string."
        echo "Run this from a Jolteon worktree (or 'jt worktree setup' first)."
        exit 1
    fi

    # Read the raw value directly rather than sourcing: dotenv values are
    # unquoted, and a connection string is full of ';' — which the shell would
    # treat as command separators, truncating it at the first field.
    local conn
    conn="$(sed -nE 's/^[[:space:]]*COMPANION_STORAGE_CONNECTION_STRING=(.*)$/\1/p' "$dashboard_env" | head -1)"
    conn="${conn%\"}"; conn="${conn#\"}"   # strip optional surrounding quotes
    conn="${conn%\'}"; conn="${conn#\'}"
    if [ -z "$conn" ]; then
        echo "Error: COMPANION_STORAGE_CONNECTION_STRING is not set in $dashboard_env."
        exit 1
    fi

    local account
    account="$(printf '%s' "$conn" | sed -E 's/.*AccountName=([^;]*).*/\1/')"

    if az storage cors list --services b --connection-string "$conn" -o json 2>/dev/null \
        | grep -qF "$origin"; then
        echo "CORS already allows $origin on blob account '$account'. Nothing to do."
        echo "Run 'jt app run --dev', then open a pulse report in the UI."
        exit 0
    fi

    echo "Adding blob CORS rule on '$account': allow GET/HEAD from $origin ..."
    az storage cors add \
        --services b \
        --methods GET HEAD \
        --origins "$origin" \
        --allowed-headers '*' \
        --exposed-headers '*' \
        --max-age 3600 \
        --connection-string "$conn"

    echo ""
    echo "Done. The locally-run UI can now fetch pulse-report blobs from '$account'."
    echo "Next: 'jt app run --dev', then open a pulse report in the app."
}

# ─── MCP commands ──────────────────────────────────────────

# management-mcp's tools ARE dashboard-api's routes, read from app/openapi_spec.json — a
# gitignored file generated from dashboard-api's code (the Docker build does the same).
# Regenerated when missing or older than any dashboard-api source file, so the MCP serves
# the routes of the dashboard-api beside it rather than whatever they were when the file was
# first made. A few seconds, and only when something changed.
mcp_spec_fresh() {
    local spec="$1/app/openapi_spec.json"
    [ -f "$spec" ] && [ -z "$(find "$2/app" -name '*.py' -newer "$spec" -print -quit 2>/dev/null)" ]
}

mcp_ensure_spec() {
    local mcp_dir="$1" api_dir="$2"
    mcp_spec_fresh "$mcp_dir" "$api_dir" && return 0
    echo "Generating management-mcp's OpenAPI spec from dashboard-api..."
    if ! (cd "$api_dir" && \
            GOOGLE_GEOCODING_API_KEY="${GOOGLE_GEOCODING_API_KEY:-x}" \
            WORKOS_CLIENT_ID="${WORKOS_CLIENT_ID:-x}" \
            WORKOS_CLIENT_SECRET="${WORKOS_CLIENT_SECRET:-x}" \
            FLUVIUS_CLIENT_SECRET="${FLUVIUS_CLIENT_SECRET:-x}" \
            FLUVIUS_SUBSCRIPTION_KEY="${FLUVIUS_SUBSCRIPTION_KEY:-x}" \
            DAGSTER_URL="${DAGSTER_URL:-http://x}" \
            PYTHONPATH=. uv run --quiet python ../management-mcp/scripts/generate_openapi_spec.py >/dev/null); then
        echo "Warning: could not generate $mcp_dir/app/openapi_spec.json — skipping management-mcp." >&2
        return 1
    fi
}

cmd_mcp_run() {
    # --as is accepted (via parse_env_flag) because the analytics chain needs a
    # persona: analytics-api only bypasses auth when DISABLE_AUTH_RAW is on, and
    # without the bypass it rejects the MCP's forwarded dev token.
    parse_env_flag "$@"
    local env="$ENV_CHOICE" target="management" port="" _a
    if [ ${#REMAINING_ARGS[@]} -gt 0 ]; then
        local i=0
        while [ $i -lt ${#REMAINING_ARGS[@]} ]; do
            _a="${REMAINING_ARGS[$i]}"
            case "$_a" in
                --analytics)  target="analytics"; i=$((i + 1)) ;;
                --management) target="management"; i=$((i + 1)) ;;
                --port)
                    port="${REMAINING_ARGS[$((i + 1))]:-}"
                    [ -z "$port" ] && { echo "--port needs a value"; exit 1; }
                    i=$((i + 2))
                    ;;
                *)
                    echo "Unknown argument: $_a"
                    echo "Usage: jt mcp run [--analytics] [--local|--dev|--fork|--prd] [--as <persona>] [--port N]"
                    exit 1
                    ;;
            esac
        done
    fi

    if [ -z "$env" ]; then
        env="$(prompt_env dev)"
    fi

    if [ "$target" = "analytics" ]; then
        mcp_run_analytics "$env" "${port:-8003}"
        return
    fi

    [ -z "$port" ] && port="8002"

    local mcp_dir api_dir
    mcp_dir="$(cd services/management-mcp 2>/dev/null && pwd)" || mcp_dir="$REPO/services/management-mcp"
    api_dir="$(cd services/dashboard-api 2>/dev/null && pwd)" || api_dir="$REPO/services/dashboard-api"

    if ! mcp_spec_fresh "$mcp_dir" "$api_dir"; then
        # Source env config for DB creds (needed by dashboard-api import)
        local env_file="$HOME/.config/jt/environments.sh"
        if [ -f "$env_file" ]; then
            # shellcheck source=/dev/null
            source "$env_file"
            env_dev  # dev creds are fine for spec generation
        fi
        mcp_ensure_spec "$mcp_dir" "$api_dir" || exit 1
    fi

    # Stop any existing MCP server on this port
    local mcp_pids
    mcp_pids=$(lsof -ti :"$port" 2>/dev/null || true)
    if [ -n "$mcp_pids" ]; then
        echo "$mcp_pids" | xargs kill -9 2>/dev/null || true
        sleep 1
    fi

    # Set environment-specific config
    local dashboard_url disable_auth
    case "$env" in
        fork|dev)
            dashboard_url="https://dashboard-api.dev.companion.energy"
            disable_auth="false"
            ;;
        prd)
            dashboard_url="https://dashboard-api.prd.companion.energy"
            disable_auth="false"
            ;;
    esac

    # Source dashboard-api .env for WorkOS creds
    local dashboard_env
    dashboard_env="$(cd services/dashboard-api 2>/dev/null && pwd)/.env" || dashboard_env="$REPO/services/dashboard-api/.env"
    if [ -f "$dashboard_env" ]; then
        set -a
        # shellcheck source=/dev/null
        source "$dashboard_env"
        set +a
    fi

    echo ""
    echo "Starting MCP service..."
    echo "  Environment:    $env"
    echo "  Dashboard API:  $dashboard_url"
    echo "  Auth:           $([ "$disable_auth" = "true" ] && echo "disabled" || echo "OAuth (WorkOS)")"
    echo "  MCP endpoint:   http://localhost:$port/mcp/"
    echo ""

    trap 'echo ""; echo "Stopping MCP service..."; kill 0' INT TERM

    (cd "$mcp_dir" && \
        DASHBOARD_API_BASE_URL="$dashboard_url" \
        DISABLE_AUTH="$disable_auth" \
        MCP_BASE_URL="http://localhost:$port" \
        COMPANION_ENV="local" \
        LOG_LEVEL="INFO" \
        uv run uvicorn app.main:app --port "$port") &

    wait
}

# Run the analytics MCP (:8003) plus the analytics-api (:8122) it queries, against
# the chosen environment's database. This is the '--agent' stack of 'jt app run'
# minus the frontend, backend and agent-service — for when you only need to
# exercise the MCP itself. analytics-api reads the PG_*/AUTH_*_OVERWRITE exported
# here, so --dev/--prd point it at THAT database, not a local one.
mcp_run_analytics() {
    local env="$1" port="$2"

    local env_file="$HOME/.config/jt/environments.sh"
    if [ ! -f "$env_file" ]; then
        echo "Error: missing $env_file"
        echo ""
        echo "Create it with env_dev() and env_prd() shell functions (both forks come from the Tiger CLI)."
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$env_file"
    # Every value parse_env_flag can produce needs a branch here. A missing one is silent:
    # no env_* runs, PG_* stays unset, and the first thing to read it fails somewhere far
    # from the cause. The `*)` arm makes that loud instead.
    case "$env" in
        local)    env_local || exit 1 ;;
        dev)      env_dev ;;
        # Neither fork is an env_* function: a fork's host AND port change every time one
        # is taken, so both are resolved from the Tiger CLI rather than maintained by hand.
        # fork_env also sets AGENT_PG_*, which is why there is no agent_env_*fork either —
        # a pair has to come from ONE environment, so one call resolves both halves.
        fork)     fork_env dev || exit 1 ;;
        prd_fork) fork_env prd || exit 1 ;;
        prd)      env_prd ;;
        *)        echo "Error: no env_$env in $env_file." >&2; exit 1 ;;
    esac

    # --local resolves personas through the dev rows: its seed carries dev's own identities.
    if [ -n "${PERSONA:-}" ]; then
        local persona_env="$env"
        [ "$env" = "local" ] && persona_env="dev"
        resolve_persona "$persona_env" "$PERSONA" || {
            echo "Aborting: persona '$PERSONA' is not defined for env '$persona_env' in $env_file."
            exit 1
        }
    fi

    # analytics-api only bypasses auth when DISABLE_AUTH_RAW is on (a persona, or
    # env_prd). The MCP must match: otherwise analytics-api rejects the token the
    # MCP forwards and every data query fails.
    local disable_auth="${DISABLE_AUTH_RAW:-false}"
    if [ "$disable_auth" = "true" ]; then
        export COMPANION_ENV=local
    fi

    local analytics_api_dir mcp_dir
    analytics_api_dir="$(cd services/analytics-api 2>/dev/null && pwd)" \
        || analytics_api_dir="$REPO/services/analytics-api"
    mcp_dir="$(cd services/analytics-mcp 2>/dev/null && pwd)" || mcp_dir="$REPO/services/analytics-mcp"

    # analytics-api loads its OWN .env and has required WorkOS creds with no
    # defaults, so it crashes on boot without one. Warn early rather than letting
    # the launch fail cryptically.
    if [ ! -f "$analytics_api_dir/.env" ]; then
        echo ""
        echo "⚠  $analytics_api_dir/.env not found — analytics-api needs WorkOS creds to boot."
        echo "   Create it, mirroring the WORKOS_* values in services/dashboard-api/.env."
        echo ""
    fi

    # Free both ports so a re-run just works. -sTCP:LISTEN so we never match (and
    # kill) a client connected to the port — see the note in cmd_app_stop.
    local p pids
    for p in "$port" 8122; do
        pids=$(lsof -ti :"$p" -sTCP:LISTEN 2>/dev/null || true)
        if [ -n "$pids" ]; then
            echo "$pids" | xargs kill -9 2>/dev/null || true
        fi
    done
    sleep 1

    echo ""
    echo "Starting analytics MCP stack..."
    echo "  Environment:    $env  (DB: $env)"
    echo "  Persona:        ${PERSONA:-none}"
    echo "  Auth:           $([ "$disable_auth" = "true" ] && echo "bypassed (whole chain)" || echo "OAuth (WorkOS)")"
    echo "  Analytics API:  http://localhost:8122"
    echo "  MCP endpoint:   http://localhost:$port/mcp/"
    echo ""

    trap 'echo ""; echo "Stopping analytics MCP stack..."; kill 0' INT TERM

    (cd "$analytics_api_dir" && uv run uvicorn app.main:app --port 8122) &

    # cd into the dir so analytics-mcp's pydantic-settings picks up its own .env
    # (e.g. POSTHOG_PROJECT_TOKEN); the inline vars below win over that file.
    (cd "$mcp_dir" && \
        env ANALYTICS_API_BASE_URL="http://localhost:8122" \
            DISABLE_AUTH="$disable_auth" \
            MCP_BASE_URL="http://localhost:$port" \
            COMPANION_ENV="local" \
            LOG_LEVEL="INFO" \
            uv run uvicorn app.main:app --port "$port") &

    wait
}

cmd_mcp_stop() {
    local port="" target="management"
    while [ $# -gt 0 ]; do
        case "$1" in
            --analytics)  target="analytics"; shift ;;
            --management) target="management"; shift ;;
            --port) port="${2:-}"; [ -z "$port" ] && { echo "--port needs a value"; exit 1; }; shift 2 ;;
            *)      echo "Unknown argument: $1"; echo "Usage: jt mcp stop [--analytics] [--port N]"; exit 1 ;;
        esac
    done

    # The analytics MCP fronts an analytics-api on 8122; stop both, else the next
    # run can't bind it. -sTCP:LISTEN so a connected client is never matched.
    local ports
    if [ "$target" = "analytics" ]; then
        ports="${port:-8003} 8122"
    else
        ports="${port:-8002}"
    fi

    local p pids stopped=0
    for p in $ports; do
        pids=$(lsof -ti :"$p" -sTCP:LISTEN 2>/dev/null || true)
        if [ -n "$pids" ]; then
            echo "$pids" | xargs kill -9 2>/dev/null || true
            echo "Stopped MCP service (port $p)"
            stopped=1
        fi
    done
    [ "$stopped" -eq 0 ] && echo "No MCP service running on port(s):$(printf ' %s' $ports)"
    return 0
}

# ─── Agent-service commands ────────────────────────────────
#
# The "My Companion" in-product AI assistant. Unlike the other services it's a
# standalone uv project (own uv.lock, excluded from the workspace so it can pin
# a current anthropic) and owns its OWN Postgres via docker compose — never the
# Jolteon DB. It loads config from its own services/agent-service/.env
# (pydantic-settings, env_file=".env"), so we cd into the dir and let it read
# that file; ANTHROPIC_API_KEY is the one secret you must supply. See its
# .env.example for the full list.

# Resolve the agent-service dir (current worktree first, then the main checkout).
agent_service_dir() {
    (cd services/agent-service 2>/dev/null && pwd) || printf '%s\n' "$REPO/services/agent-service"
}

# Ensure services/agent-service/.env exists (seed from example) and warn if the
# Anthropic key is still unset. The service boots either way; only chat calls
# fail without a key.
# Export WORKOS_CLIENT_ID / WORKOS_CLIENT_SECRET from dashboard-api's .env so
# analytics-api (which requires them and has no defaults) boots without a second
# .env of its own. Only these two keys, and only when not already set, so an
# explicit export in environments.sh still wins.
agent_export_workos() {
    local src line
    src="$(cd services/dashboard-api 2>/dev/null && pwd)/.env" \
        || src="$REPO/services/dashboard-api/.env"
    [ -f "$src" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            WORKOS_CLIENT_ID=*)     [ -z "${WORKOS_CLIENT_ID:-}" ]     && export "$line" ;;
            WORKOS_CLIENT_SECRET=*) [ -z "${WORKOS_CLIENT_SECRET:-}" ] && export "$line" ;;
        esac
    done < "$src"
    return 0
}

# Bring up agent-service's docker Postgres + blob emulator (compose.yaml). Only when the
# agent DB is local. Deliberately does NOT migrate or seed: those are one-off setup steps,
# and running them on every launch hides a broken database behind a slow start.
agent_ensure_db() {
    local agent_dir="$1"
    # Already answering (Postgres, and Azurite on :10000) needs no docker at all — which also
    # keeps a shell without docker-socket access from warning about a database that is up.
    if pg_isready -h localhost -p 5433 -q && (exec 3<>/dev/tcp/127.0.0.1/10000) 2>/dev/null; then
        return 0
    fi
    command -v docker >/dev/null 2>&1 || { echo "Warning: docker not found — agent DB unavailable."; return 0; }
    docker compose -f "$agent_dir/compose.yaml" up -d --wait >/dev/null 2>&1 \
        || docker compose -f "$agent_dir/compose.yaml" up -d >/dev/null 2>&1 \
        || echo "Warning: could not start the agent DB — agent-service will fail to connect."
    return 0
}

# Start the local LiteLLM gateway on :4000.
#
# The Anthropic key is the exported one (environments.sh), else services/agent-service/.env —
# the same file agent-service reads — so there is no second copy to rotate. The exported one
# wins because a worktree's .env can carry an empty ANTHROPIC_API_KEY= line, which used to
# override a perfectly good key. Backgrounded like the other services, so a failure here
# leaves the rest of the stack up.
agent_litellm_start() {
    local agent_dir="$1" key="${ANTHROPIC_API_KEY:-}"
    if [ -z "$key" ] && [ -f "$agent_dir/.env" ]; then
        key="$(sed -n 's/^ANTHROPIC_API_KEY=//p' "$agent_dir/.env" | head -1)"
    fi
    if [ -z "$key" ]; then
        echo "Warning: no ANTHROPIC_API_KEY exported or in $agent_dir/.env — LiteLLM will 401 on every turn."
    fi
    # `uv run --with` resolves litellm into a cached ephemeral environment; the first run
    # after a cache clear takes a minute, later ones are instant. Nothing to install by hand.
    # Output goes to the shared terminal like every other service, so `jt app run ...
    # | tee /tmp/jt.log` captures the gateway's request log too. Discarding it hid
    # whether a slow turn was in flight or wedged.
    (env ANTHROPIC_API_KEY="$key" \
         uv run --quiet --with 'litellm[proxy]' \
             litellm --config "$LITELLM_CONFIG" --port 4000 2>&1 | sed 's/^/[litellm] /') &
    return 0
}

# The local gateway's URL + key, or empty strings when there is no gateway to point at.
#
# agent-service chooses its LLM client by whether LITELLM_BASE_URL is set: gateway when it
# is, direct Anthropic otherwise. That choice has to match the CATALOG the agent database
# holds. A deployed catalog is gateway-named (`anthropic/claude-opus-5`) and the direct
# client passes the id through verbatim, so Anthropic 404s on every turn — which is exactly
# what happens when the gateway is running on :4000 and nothing tells the service about it.
#
# The key is read out of the gateway's own config rather than duplicated here, so the two
# cannot drift: the config's `master_key` IS what agent-service must send as LITELLM_API_KEY.
agent_gateway_env() {
    agent_gateway_url=""
    agent_gateway_key=""
    [ -f "$LITELLM_CONFIG" ] || return 0
    agent_gateway_url="http://localhost:4000"
    agent_gateway_key="$(sed -n 's/^[[:space:]]*master_key:[[:space:]]*//p' "$LITELLM_CONFIG" | head -1)"
    if [ -z "$agent_gateway_key" ]; then
        echo ""
        echo "⚠  No master_key in $LITELLM_CONFIG — agent-service will send 'unset' and the"
        echo "   gateway will 401 every turn. Add one under general_settings."
        echo ""
    fi
    return 0
}

agent_ensure_env() {
    local agent_dir="$1" env_file="$1/.env"
    if [ ! -f "$env_file" ]; then
        if [ -f "$agent_dir/.env.example" ]; then
            cp "$agent_dir/.env.example" "$env_file"
            echo "Created $env_file from .env.example."
        else
            echo "Warning: no .env or .env.example in $agent_dir."
        fi
    fi
    # An exported key (environments.sh) counts: it outranks the .env for agent-service, and
    # it is what the gateway uses.
    if [ -z "${ANTHROPIC_API_KEY:-}" ] && ! grep -qE '^ANTHROPIC_API_KEY=.+' "$env_file" 2>/dev/null; then
        echo ""
        echo "⚠  ANTHROPIC_API_KEY is not set in $env_file"
        echo "   Add your key there before using the chat:"
        echo "     ANTHROPIC_API_KEY=sk-ant-..."
        echo ""
    fi
}

# ─── Invoice reconciliation worker ─────────────────────────
#
# invoice-service is a WORKER, not a server. `python -m app` polls the Jolteon database
# for invoices at `uploaded` (translate leg) and `translated` (reconcile leg) and drives
# each one with its own LLM call. Two consequences shape everything below.
#
# It has no port, so there is nothing to lsof: it is backgrounded into the app's process
# group and dies with the Ctrl+C trap, exactly like litellm. And it reads the platform's
# modelled cost straight from the database through companion.core — NOT over HTTP — so it
# needs no analytics-api and no MCP, only PG_* pointing at the same database the backend
# is on.
invoice_service_dir() {
    (cd services/invoice-service 2>/dev/null && pwd) || printf '%s\n' "$REPO/services/invoice-service"
}

# The worker reads its configuration from the ENVIRONMENT: services/invoice-service has no
# .env of its own and no .env.example to seed one. Three values it will not start without,
# lifted from the two .env files that already hold them rather than kept in a third copy:
#
#   * CUSTOMER_DATA_STORAGE_CONNECTION_STRING — the account holding the invoice PDF.
#     dashboard-api's intake uploads there; the worker downloads from the same place.
#   * ANTHROPIC_API_KEY — the worker calls Anthropic DIRECTLY, never through the local
#     gateway, so this has to be a real key even when litellm is up.
#   * RECONCILE_ENABLED — off by default in the service, because reconciling is a
#     per-invoice LLM + analytics-DB run. Local is exactly where you want it on.
invoice_export_secrets() {
    local dash agent line
    dash="$(cd services/dashboard-api 2>/dev/null && pwd)/.env" || dash="$REPO/services/dashboard-api/.env"
    agent="$(cd services/agent-service 2>/dev/null && pwd)/.env" || agent="$REPO/services/agent-service/.env"
    if [ -f "$dash" ] && [ -z "${CUSTOMER_DATA_STORAGE_CONNECTION_STRING:-}" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in CUSTOMER_DATA_STORAGE_CONNECTION_STRING=*) export "$line" ;; esac
        done < "$dash"
    fi
    if [ -f "$agent" ] && [ -z "${ANTHROPIC_API_KEY:-}" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in ANTHROPIC_API_KEY=*) export "$line" ;; esac
        done < "$agent"
    fi
    # Both legs, on purpose. Translate alone leaves every invoice at `translated` with no
    # verdict, which looks like the worker is broken rather than half-configured.
    export RECONCILE_ENABLED="${RECONCILE_ENABLED:-true}"
    return 0
}

# Warn about what the worker needs, then background it. Returns 0 always: a missing
# credential should not stop the app stack that was the point of the command.
invoice_worker_start() {
    local invoice_dir="$1" env="$2"

    if [ ! -d "$invoice_dir" ]; then
        echo "Warning: $invoice_dir not found — skipping the invoice worker."
        return 0
    fi

    # Refused on prd for the same reason `--prd --agent` is, and it is worth being precise
    # about which half: reconciling READS the platform's cost, which the read-only role can
    # do. But the worker also WRITES — it moves each invoice uploaded -> translating ->
    # translated -> reconciling -> ready and stores the translation and the verdict. So the
    # read-only role cannot run it at all, and a writable one would mean a laptop writing
    # verdicts into production.
    #
    # --prd-fork is the answer rather than an exception to this: a fork is a throwaway copy
    # on its own host, so writing to it is real data with none of the consequence. That is
    # the only way to watch this worker reconcile against actual customer invoices.
    if [ "$env" = "prd" ]; then
        echo ""
        echo "⚠  Skipping the invoice worker: --prd is read-only and this worker writes"
        echo "   invoice status, translations and verdicts."
        echo "   For real customer data, use --prd-fork ('jt help' → Forks)."
        echo ""
        return 0
    fi

    invoice_export_secrets

    # Both of these make the worker REFUSE TO START (it validates credentials up front so a
    # misconfigured run fails loudly instead of marking every invoice failed), so say so
    # rather than letting the stack come up with one service quietly absent.
    if [ -z "${CUSTOMER_DATA_STORAGE_CONNECTION_STRING:-}" ]; then
        echo ""
        echo "⚠  No CUSTOMER_DATA_STORAGE_CONNECTION_STRING — the invoice worker refuses to"
        echo "   start without it. Add it to services/dashboard-api/.env from"
        echo "   stcustomerdatadevweu (the same value invoice intake needs)."
        echo ""
    fi
    if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
        echo ""
        echo "⚠  No ANTHROPIC_API_KEY — the invoice worker refuses to start without it."
        echo "   Add it to services/agent-service/.env."
        echo ""
    fi

    # `:-` rather than a bare expansion: this runs under `set -u`, and an env that somehow
    # left PG_* unset should show up as a legible warning line, not as an unbound-variable
    # abort halfway through starting the stack.
    if [ -z "${PG_HOST:-}" ]; then
        echo ""
        echo "⚠  Skipping the invoice worker: no PG_HOST, so it has no database to poll."
        echo ""
        return 0
    fi
    # A still-templated host, same guard the agent stack has: without it the worker starts,
    # fails DNS on every pass, and backs off exponentially — which reads as "the worker is
    # broken" rather than "you have not pasted the fork's host in yet".
    case "$PG_HOST" in
        REPLACE_*)
            echo ""
            echo "⚠  Skipping the invoice worker: PG_HOST is still a REPLACE_* placeholder."
            echo "   Take the forks and paste their hosts into ~/.config/jt/environments.sh"
            echo "   ('jt help' → Forks)."
            echo ""
            return 0
            ;;
    esac
    echo "  Invoice worker:  polling $PG_HOST every 10s (translate + reconcile)"
    # `sed -u` and `-u` on python: without both, the worker's output is invisible whenever
    # this is not a tty (`jt app run ... > log`), because sed block-buffers and python
    # buffers its own stdout. A worker whose log only appears in 4KB chunks reads as a
    # worker that is not running — which is the one thing its log is for.
    (cd "$invoice_dir" && uv run python -u -m app 2>&1 | sed -u 's/^/[invoice] /') &
    return 0
}

# PIDs of invoice workers whose working directory is THIS worktree's invoice-service.
# `python -m app` is a generic command line — another worktree's worker, or an unrelated
# `-m app`, must not be killed from here — so the cwd is what identifies ours.
invoice_worker_pids() {
    local dir="$1" pid cwd
    for pid in $(pgrep -f 'python -m app' 2>/dev/null || true); do
        cwd="$(lsof -a -d cwd -p "$pid" -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
        [ "$cwd" = "$dir" ] && printf '%s\n' "$pid"
    done
    return 0
}

cmd_agent_run() {
    local port="8140"
    while [ $# -gt 0 ]; do
        case "$1" in
            --port) port="${2:-}"; [ -z "$port" ] && { echo "--port needs a value"; exit 1; }; shift 2 ;;
            *)      echo "Unknown argument: $1"; echo "Usage: jt agent run [--port N]"; exit 1 ;;
        esac
    done

    local agent_dir; agent_dir="$(agent_service_dir)"
    if [ ! -d "$agent_dir" ]; then
        echo "Error: $agent_dir not found."
        echo "The agent-service isn't in this checkout yet (still on a feature branch?)."
        echo "Run this from a worktree that has services/agent-service."
        exit 1
    fi

    # Config: the service reads its own .env from CWD (seeded here on first run). Its
    # database comes from the AGENT_PG_* of whichever environment you picked — there is
    # no local Postgres in this setup, so `jt agent run` alone has none configured.
    agent_ensure_env "$agent_dir"
    if [ -z "${AGENT_PG_HOST:-}" ]; then
        echo ""
        echo "⚠  No agent database configured. 'jt agent run' does not pick an environment;"
        echo "   use 'jt app run --dev --agent' (or --fork) so agent_env_<env> is applied."
        echo ""
    fi

    # Free the port so a re-run just works (mirrors 'jt mcp run').
    local pids
    pids=$(lsof -ti :"$port" 2>/dev/null || true)
    if [ -n "$pids" ]; then
        echo "$pids" | xargs kill -9 2>/dev/null || true
        sleep 1
    fi

    echo ""
    echo "Starting agent-service..."
    echo "  Service:        http://localhost:$port"
    echo "  Database:       postgresql://agent:agent@localhost:5433/agent (docker)"
    echo "  Analytics MCP:  ANALYTICS_MCP_URL from .env (default http://localhost:8003/mcp)"
    echo ""
    echo "Viewing from another machine (e.g. your Mac)? Run 'jt app forward' there"
    echo "to tunnel port $port, then open http://localhost:$port."
    echo ""

    trap 'echo ""; echo "Stopping agent-service..."; kill 0' INT TERM

    (cd "$agent_dir" && uv run uvicorn app.main:app --port "$port") &
    wait
}

cmd_agent_stop() {
    local port="8140"
    while [ $# -gt 0 ]; do
        case "$1" in
            --port) port="${2:-}"; [ -z "$port" ] && { echo "--port needs a value"; exit 1; }; shift 2 ;;
            *)      echo "Unknown argument: $1"; echo "Usage: jt agent stop [--port N]"; exit 1 ;;
        esac
    done

    local pids
    pids=$(lsof -ti :"$port" 2>/dev/null || true)
    if [ -n "$pids" ]; then
        echo "$pids" | xargs kill -9 2>/dev/null || true
        echo "Stopped agent-service (port $port)"
    else
        echo "No agent-service running on port $port."
    fi
    # The docker Postgres is left running on purpose (data persists, faster
    # restarts). Stop it explicitly when you want it gone:
    echo "Agent DB left running. Stop it with:"
    echo "  docker compose -f $(agent_service_dir)/compose.yaml down"
}

cmd_invoice_run() {
    while [ $# -gt 0 ]; do
        case "$1" in
            *) echo "Unknown argument: $1"; echo "Usage: jt invoice run"; exit 1 ;;
        esac
    done

    local invoice_dir; invoice_dir="$(invoice_service_dir)"
    if [ ! -d "$invoice_dir" ]; then
        echo "Error: $invoice_dir not found."
        echo "Run this from a worktree that has services/invoice-service."
        exit 1
    fi

    # Like 'jt agent run', this does NOT pick an environment: the worker reads PG_* from
    # the environment, so on its own it has no database. It is here for the case where the
    # app stack is already up in another terminal and you only want to restart the worker.
    if [ -z "${PG_HOST:-}" ]; then
        echo ""
        echo "⚠  No PG_HOST. 'jt invoice run' does not pick an environment — source one"
        echo "   first, or use 'jt app run --dev --agent', which starts this worker with"
        echo "   the same database as the backend."
        echo ""
    fi

    invoice_export_secrets

    echo ""
    echo "Starting the invoice reconciliation worker..."
    echo "  Database:  ${PG_HOST:-<unset>}"
    echo "  Legs:      translate + reconcile (RECONCILE_ENABLED=$RECONCILE_ENABLED)"
    echo "  Poll:      every 10s; claims up to 50 invoices a pass"
    echo ""

    # `trap -` first: `kill 0` signals this shell too, which re-enters the handler and
    # prints the line once per child otherwise. Disarming makes it fire exactly once.
    trap 'trap - INT TERM; echo ""; echo "Stopping the invoice worker..."; kill 0' INT TERM
    (cd "$invoice_dir" && uv run python -m app) &
    wait
}

cmd_invoice_stop() {
    local invoice_dir; invoice_dir="$(invoice_service_dir)"
    local pids; pids="$(invoice_worker_pids "$invoice_dir")"
    if [ -n "$pids" ]; then
        echo "$pids" | xargs kill 2>/dev/null || true
        echo "Stopped the invoice worker ($(echo "$pids" | tr '\n' ' '))"
    else
        echo "No invoice worker running for $invoice_dir."
    fi
}

# ─── Browser commands ──────────────────────────────────────

cmd_browser_open() {
    local profile="${1:-}"
    local url="${2:-http://localhost:5173}"
    local profiles_dir="$WORK/browser-profiles"

    if [ -z "$profile" ]; then
        # No profile: fuzzy-pick one of the available browser profiles.
        local names
        names="$(for p in "$profiles_dir"/*/; do [ -d "$p" ] && basename "$p"; done)"
        [ -z "$names" ] && { echo "No browser profiles in $profiles_dir"; exit 1; }
        profile="$(printf '%s\n' "$names" | pick_line "profile> ")" || { echo "Aborted."; exit 0; }
        [ -z "$profile" ] && { echo "No selection."; exit 1; }
    fi

    if [ ! -d "$profiles_dir/$profile" ]; then
        echo "Error: unknown profile '$profile'"
        echo "Available profiles:"
        for p in "$profiles_dir"/*/; do
            echo "  $(basename "$p")"
        done
        exit 1
    fi

    agent-browser close 2>/dev/null || true
    echo "Opening browser: $url (profile: $profile)"
    agent-browser --profile "$profiles_dir/$profile" --headed open "$url"
}

cmd_browser_stop() {
    if pkill -f 'agent-browser' 2>/dev/null; then
        echo "Stopped agent-browser"
    else
        echo "No agent-browser running."
    fi
}

# ─── Diff commands ─────────────────────────────────────────

cmd_diff_open() {
    local base=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -b|--base) base="${2:-}"; [ -z "$base" ] && { echo "--base needs a value"; exit 1; }; shift 2 ;;
            *)         echo "Unknown argument: $1"; echo "Usage: jt diff open [--base <branch>]"; exit 1 ;;
        esac
    done

    local -a args=(diffhub cmux)
    [ -n "$base" ] && args+=(--base "$base")
    exec npx "${args[@]}"
}

cmd_diff_stop() {
    if pkill -f 'diffhub' 2>/dev/null; then
        echo "Stopped diffhub"
    else
        echo "No diffhub process running."
    fi
}

# ─── SDK commands ──────────────────────────────────────────

cmd_sdk_generate() {
    local javm_bin
    javm_bin="$(command -v javm 2>/dev/null || echo "$HOME/.local/bin/javm")"
    if [ ! -x "$javm_bin" ]; then
        echo "Error: javm is not installed."
        echo ""
        echo "javm is required to manage Java versions for the OpenAPI generator."
        echo "Install it first, then re-run 'jt sdk generate'."
        exit 1
    fi

    if ! curl -sf http://localhost:8000/docs >/dev/null 2>&1; then
        echo "Dashboard API is not running on localhost:8000."
        read -rp "Start it with 'jt app run'? [Y/n] " confirm
        if [[ "${confirm:-y}" =~ ^[Nn]$ ]]; then
            echo "Aborted. Start the API first, then re-run 'jt sdk generate'."
            exit 1
        fi
        cmd_app_run
        # app run blocks (wait), so we won't reach here
    fi

    local sdk_dir
    sdk_dir="$(cd packages/dashboard-api-ts-sdk 2>/dev/null && pwd)" || sdk_dir="$REPO/packages/dashboard-api-ts-sdk"

    # javm modifies JAVA_HOME/PATH via a shell function (fd3 protocol) that is
    # only available in interactive zsh. Replicate the protocol directly so the
    # env vars are exported for npm run build.
    local fd3
    fd3=$(mktemp)
    "$javm_bin" --fd3 "$fd3" use 25
    if [ -s "$fd3" ]; then
        while IFS=$'\t' read -r op key val; do
            [ "$op" = "SET" ] && export "$key=$val"
            [ "$op" = "UNSET" ] && unset "$key"
        done < "$fd3"
    fi
    rm -f "$fd3"

    echo "Generating SDK..."
    (cd "$sdk_dir" && use_pinned_node "$sdk_dir/../.." && npm run build)
    echo "Done."
}

# ─── Help ──────────────────────────────────────────────────

cmd_help() {
    cat <<'HELP'
jt — Jolteon worktree & service manager

Usage:
  jt <noun> <verb> [options]

Most commands below fuzzy-pick (fzf, else a numbered menu) when you omit the
argument in [brackets] — e.g. 'jt wt remove' lets you pick a worktree.

Worktree (alias: wt):
  jt wt                                Interactive dashboard (type to filter; Tab marks
                                       rows; keys: enter cd · Ctrl-O claude · Ctrl-E zed
                                       · → Claude sessions (resume) · Ctrl-X remove marked
                                       · Ctrl-Y copy · Ctrl-P PR · Ctrl-T new · Ctrl-R
                                       refresh · esc)
  jt worktree create <branch>          Create a new worktree and branch
  jt worktree checkout [branch]        Create a worktree from an existing remote branch
                                       (pick from remote branches if none given)
  jt worktree new                      New worktree from a blank branch, issue, or PR
  jt worktree list                     Static dashboard: worktrees grouped by day,
                                       with PR state + title, newest first
  jt worktree open [branch]            cd into a worktree (pick if no branch)
  jt worktree edit [branch]            Open worktree in Zed (default: cwd)
  jt worktree setup [branch|path]      Copy env files + install deps (default: cwd)
  jt worktree remove [branch]          Remove one worktree + local branch (safe;
                                       pick if no branch)
  jt worktree cleanup                  Bulk remove worktrees whose branch is merged
                                       into main or whose upstream was deleted
  jt worktree nuke [branch]            Force-remove worktree + delete local AND
                                       remote branch (destructive; pick if no branch)

Issue (start work from a GitHub issue):
  jt issue start [url|number]          Create a worktree+branch from a GitHub issue
                                       (branch inferred from issue type + title)
                                       and launch the chosen agent with the issue
                                       link as a starting prompt. Pick from open
                                       issues if no argument.

PR (review an existing pull request):
  jt pr review [url|number]            Check out the PR's branch into a worktree and
                                       launch the chosen agent with /code-review as
                                       the initial prompt. Pick from open PRs if no
                                       argument.

App (backend + frontend):
  jt app run [--local|--dev|--fork|--prd-fork] [--agent] [--as <persona>]
                                       Start backend + frontend (default: dev). You sign in
                                       with your real dev account on http://localhost:5173,
                                       except on --prd-fork.
                                       --local runs on the seeded databases ('jt db seed'),
                                       which carry dev's identities, so the dev login works.
                                       --fork / --prd-fork run against a throwaway Tiger
                                       fork of dev / of PRODUCTION: writable, auto-deleted.
                                       Both resolve the fork pair from the Tiger CLI and
                                       offer to take a fresh one if the recorded pair has
                                       expired ('jt fork', below). --prd-fork needs --as for
                                       now: a real login there would be a production one.
                                       --agent also starts the agent-workflow stack, every
                                       hop local: analytics-api (:8122) on the SAME database,
                                       analytics-mcp (:8003), management-mcp (:8002) on this
                                       backend, agent-service (:8140), the LiteLLM gateway
                                       (:4000), and the invoice reconciliation worker.
                                       --as <persona> is the auth bypass (personas in
                                       ~/.config/jt/environments.sh): required on --prd-fork,
                                       optional elsewhere (an agent driving the browser). The
                                       assistant ignores it and acts as a fixed root admin.
  jt app stop                          Stop backend + frontend (+ the --agent stack;
                                       the agent docker DB is left running)
  jt app forward [--env <name>] [--host <ssh-host>]
                                       Tunnel app ports from another machine
                                       (default host: desktop)
                                       (5173/8000/8140) to localhost on this machine.
                                       --env tunnels that machine's 'jt env' of that name.

Env (parallel app stacks, one per worktree, each in its own network namespace):
  jt env up [--local|--dev|--fork|--prd-fork] [--agent] [--as <persona>]
                                       From a worktree: run its whole app ('jt app run'
                                       with those flags) in an env named after the
                                       worktree. Every service keeps its usual port inside,
                                       so several envs run at once. Default --local, with
                                       databases of its own (jolteon_<name>/agent_<name>),
                                       seeded on first start. A systemd user unit
                                       (jt-env-<name>): outlives the shell, logs to the journal.
                                       Prints the preview commands when it is up.
  jt env exec [name] -- <cmd>          Run a command inside an env (curl localhost:8000,
                                       agent-browser …). Name defaults to this worktree's.
  jt env open [name] [path]            A browser window inside the env, with its own
                                       profile: sign in with your dev account as usual.
  jt env logs [name] [-f]              The env's output (every service).
  jt env list                          Envs, state, memory, and their preview commands.
  jt env down [name|--all] [--purge]   Stop an env; --purge also drops its databases.

  From a Mac, preview an env on this machine with: jt app forward --env <name>
  (then http://localhost:5173). One env at a time per Mac. A full env (--agent) holds
  about 4.5 GB, a plain one about 2.5 GB; each is capped at JT_ENV_MEMORY_MAX (default 8G).

MCP:
  jt mcp run [--dev|--fork|--prd] [--port N]  Start the management MCP
                                       (default: --dev, port 8002)
  jt mcp run --analytics [--local|--dev|--fork|--prd] [--as <persona>] [--port N]
                                       Start the analytics MCP (:8003) plus the
                                       analytics-api (:8122) it queries, against
                                       the env's database. Pair with --as so the
                                       whole chain is auth-bypassed, e.g.
                                       'jt mcp run --analytics --dev --as root'.
  jt mcp stop [--analytics] [--port N] Stop MCP service (management: 8002;
                                       --analytics: 8003 + 8122)

Fork (a throwaway Tiger copy of a real database, writable):
  jt fork create [--prd|--dev] [--duration 3h|6h|9h]
                                       Take a PAIR of forks (default: prd, 6h), store
                                       their passwords in ~/.pgpass and record their ids
                                       in ~/.config/jt/forks/<env>. Takes 2-5m. Then
                                       'jt app run --prd-fork --as root --agent' just works.
  jt fork status                       Per env: the recorded ids, whether each is still
                                       alive, and how long it has left.
  jt fork delete [--prd|--dev]         Delete the pair now instead of waiting for expiry.
  jt fork use <jolteon-id> <agent-id> [--prd|--dev]
                                       Adopt a pair somebody else took (the workflow, or
                                       your other machine): pulls each password from Key
                                       Vault into ~/.pgpass and records the ids.

  Always a PAIR from the same environment, which is why one command takes both. Jolteon
  holds the customer data; agent-service holds conversations AND its own copy of
  orgs/users/memberships, and it gates every request on that copy — so a jolteon_prd fork
  beside the dev agent database resolves none of the prod org ids and refuses every
  conversation.

  Only the two service IDS are ever written down. A fork's host AND port both change per
  fork, so jt asks the Tiger CLI for them at launch and reads the password out of
  ~/.pgpass — nothing to paste, and nothing secret in a file you edit.

  Forks are deleted automatically once their duration expires (tiger_fork_cleanup.yaml,
  hourly), which is why 'jt app run --fork/--prd-fork' offers to take a fresh pair when
  the recorded one has gone rather than failing. The duration lives in the fork's NAME,
  so 'jt fork create' names them exactly as tiger_fork.yaml does; a differently named
  fork is never collected and bills until someone notices.

  The workflow route still works if you would rather have the Actions record — then
  'jt fork use <jolteon-id> <agent-id>' to adopt the result:

    gh workflow run tiger_fork.yaml -f project=jolteon       -f environment=prd -f duration=6h
    gh workflow run tiger_fork.yaml -f project=agent_service -f environment=prd -f duration=6h

Local databases (docker: Jolteon on :5432, agent-service on :5433):
  jt db seed [--org <org_…>] [--force] Rebuild jolteon_seed + agent_seed from scratch:
                                       migrations; dev's orgs, users and memberships with
                                       their real ids (needs Tailscale); a demo site and
                                       grid connection with the assistant on, under your
                                       first customer org (by git email) or --org; the
                                       agent's identity mirror and a gateway-named model
                                       catalog. Refuses while something has them open
                                       (--force ends it). Then 'jt app run --local --agent'.
  jt db status                         Each seeded database: migration revision, orgs and
                                       users, default model.

Agent (the "My Companion" in-product AI assistant):
  jt agent run [--port N]              Start agent-service (default port 8140). Brings up
                                       its own docker Postgres (host port 5433), seeds
                                       services/agent-service/.env from .env.example on
                                       first run, and flags ANTHROPIC_API_KEY if unset.
  jt agent stop [--port N]             Stop agent-service (leaves the docker DB running)

Invoice (the reconciliation worker behind 'start_invoice_check'):
  jt invoice run                       Start the translate + reconcile worker against
                                       whatever PG_* is in the environment. Normally you
                                       want 'jt app run --dev --agent', which starts it
                                       alongside everything else; this is for restarting
                                       just the worker. No port: it polls the database.
  jt invoice stop                      Stop this worktree's invoice worker

Pulse (view dev pulse reports in the locally-run UI):
  jt pulse cors [origin]               Allow the local frontend origin (default
                                       http://localhost:5173) to fetch pulse-report
                                       blobs from the dev Storage account. Run once
                                       per machine, then 'jt app run --dev' and open a
                                       report in the app. Idempotent; reuses the
                                       dashboard-api connection string (no az login).

Browser:
  jt browser open [profile] [url]      Open headed browser (default: localhost:5173;
                                       pick a profile if none given)
  jt browser stop                      Stop agent-browser

SDK:
  jt sdk generate                      Generate the dashboard API TypeScript SDK

Diff (PR-style local diff viewer in cmux):
  jt diff open [--base <branch>]       Open diffhub in a cmux browser split
  jt diff stop                         Stop any running diffhub process

Docs (view plans/docs from another machine, e.g. your Mac):
  jt docs serve [dir] [--port N]       Serve the worktree's .context folder over HTTP
                                       (default port 8090); open http://pc-seba-1:<port>/

Shortcuts (top-level aliases for common worktree verbs):
  jt setup [branch|path]               Alias for 'jt worktree setup' (default: cwd)
  jt open [branch]                     Alias for 'jt worktree open'
  jt remove [branch]  (also: jt rm)    Alias for 'jt worktree remove'
  jt nuke [branch]                     Alias for 'jt worktree nuke'

Other:
  jt help                              Show this help

Examples:
  jt issue start https://github.com/Companion-energy/jolteon/issues/5918
  jt issue start 5918
  jt pr review https://github.com/Companion-energy/jolteon/pull/5917
  jt pr review 5917
  jt worktree create feat/battery-charts
  jt worktree checkout feat/partner-portal-v1
  jt wt open feat/battery-charts
  jt app run --dev --agent
  jt db seed && jt app run --local --agent
  jt env up --agent && jt env exec -- curl -s localhost:8000/health
  jt app run --prd-fork --as root --agent
  jt app forward
  jt mcp run --dev
  jt mcp run --prd --port 9000
  jt agent run
  jt agent stop
  jt pulse cors
  jt browser open customer
  jt browser open root http://localhost:5173/admin
  jt diff open
  jt diff open --base main
  jt docs serve
HELP
}

# ─── Main ──────────────────────────────────────────────────

dispatch_worktree() {
    local verb="${1:-ui}"        # bare 'jt wt' -> interactive dashboard
    shift 2>/dev/null || true
    case "$verb" in
        ui|i)        cmd_worktree_ui ;;
        create)      cmd_worktree_create "${1:-}" ;;
        checkout|co) cmd_worktree_checkout "${1:-}" ;;
        new)         cmd_worktree_new ;;
        list|ls)     cmd_worktree_list ;;
        open)        cmd_worktree_open "${1:-}" ;;
        edit)        cmd_worktree_edit "${1:-}" ;;
        setup)       cmd_worktree_setup "${1:-}" ;;
        remove|rm)   cmd_worktree_remove "${1:-}" ;;
        cleanup)     cmd_worktree_cleanup ;;
        nuke)        cmd_worktree_nuke "${1:-}" ;;
        # Internal verbs used by the fzf UI (preview / actions / reload feed).
        _preview)    cmd_worktree_preview "$@" ;;
        _sesspreview) cmd_session_preview "${1:-}" ;;
        _fzffeed)    _wt_fzf_feed | tee "$(_wt_feed_cache)" ;;
        _copy)       _wt_copy "${1:-}" ;;
        _prweb)      _wt_prweb "${1:-}" ;;
        _zed)        _wt_zed "${1:-}" ;;
        _rmmulti)    _wt_rm_multi "$@" ;;
        *)           echo "Unknown worktree verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_app() {
    local verb="${1:-}"
    shift 2>/dev/null || true
    case "$verb" in
        run)                cmd_app_run "$@" ;;
        stop)               cmd_app_stop ;;
        forward|fwd|tunnel) cmd_app_forward "$@" ;;
        *)    echo "Unknown app verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_mcp() {
    local verb="${1:-}"
    shift 2>/dev/null || true
    case "$verb" in
        run)  cmd_mcp_run "$@" ;;
        stop) cmd_mcp_stop "$@" ;;
        *)    echo "Unknown mcp verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_agent() {
    local verb="${1:-}"
    shift 2>/dev/null || true
    case "$verb" in
        run)  cmd_agent_run "$@" ;;
        stop) cmd_agent_stop "$@" ;;
        *)    echo "Unknown agent verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_invoice() {
    local verb="${1:-}"
    shift 2>/dev/null || true
    case "$verb" in
        run)  cmd_invoice_run "$@" ;;
        stop) cmd_invoice_stop "$@" ;;
        *)    echo "Unknown invoice verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_fork() {
    local verb="${1:-status}"
    shift 2>/dev/null || true
    case "$verb" in
        create|new)   cmd_fork_create "$@" ;;
        status|list|ls) cmd_fork_status ;;
        delete|rm)    cmd_fork_delete "$@" ;;
        use)          cmd_fork_use "$@" ;;
        *)    echo "Unknown fork verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_env() {
    local verb="${1:-list}"
    shift 2>/dev/null || true
    case "$verb" in
        up|start)    cmd_env_up "$@" ;;
        down|stop)   cmd_env_down "$@" ;;
        exec|x)      cmd_env_exec "$@" ;;
        open)        cmd_env_open "$@" ;;
        logs|log)    cmd_env_logs "$@" ;;
        list|ls)     cmd_env_list ;;
        ports)       cmd_env_ports "$@" ;;
        _run)        cmd_env_run "$@" ;;
        *)    echo "Unknown env verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_db() {
    local verb="${1:-status}"
    shift 2>/dev/null || true
    case "$verb" in
        seed)      cmd_db_seed "$@" ;;
        status|ls) cmd_db_status ;;
        *)    echo "Unknown db verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_pulse() {
    local verb="${1:-}"
    shift 2>/dev/null || true
    case "$verb" in
        cors) cmd_pulse_cors "${1:-}" ;;
        *)    echo "Unknown pulse verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_browser() {
    local verb="${1:-}"
    shift 2>/dev/null || true
    case "$verb" in
        open) cmd_browser_open "${1:-}" "${2:-}" ;;
        stop) cmd_browser_stop ;;
        *)    echo "Unknown browser verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_sdk() {
    local verb="${1:-}"
    shift 2>/dev/null || true
    case "$verb" in
        generate|gen) cmd_sdk_generate ;;
        *)            echo "Unknown sdk verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_issue() {
    local verb="${1:-}"
    shift 2>/dev/null || true
    case "$verb" in
        start) cmd_issue_start "${1:-}" ;;
        *)     echo "Unknown issue verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_pr() {
    local verb="${1:-}"
    shift 2>/dev/null || true
    case "$verb" in
        review) cmd_pr_review "${1:-}" ;;
        *)      echo "Unknown pr verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_diff() {
    local verb="${1:-open}"
    shift 2>/dev/null || true
    case "$verb" in
        open) cmd_diff_open "$@" ;;
        stop) cmd_diff_stop ;;
        *)    echo "Unknown diff verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

dispatch_docs() {
    local verb="${1:-}"
    shift 2>/dev/null || true
    case "$verb" in
        serve) cmd_docs_serve "$@" ;;
        *)     echo "Unknown docs verb: $verb"; echo "Run 'jt help' for usage."; exit 1 ;;
    esac
}

noun="${1:-help}"
shift 2>/dev/null || true
case "$noun" in
    worktree|wt)    dispatch_worktree "$@" ;;
    app)            dispatch_app "$@" ;;
    mcp)            dispatch_mcp "$@" ;;
    agent)          dispatch_agent "$@" ;;
    invoice)        dispatch_invoice "$@" ;;
    fork)           dispatch_fork "$@" ;;
    db)             dispatch_db "$@" ;;
    env)            dispatch_env "$@" ;;
    pulse)          dispatch_pulse "$@" ;;
    browser)        dispatch_browser "$@" ;;
    sdk)            dispatch_sdk "$@" ;;
    diff)           dispatch_diff "$@" ;;
    issue)          dispatch_issue "$@" ;;
    pr)             dispatch_pr "$@" ;;
    setup)          cmd_worktree_setup "${1:-}" ;;
    # Top-level shortcuts for the most-used worktree verbs (like 'setup'). All
    # accept no arg and fall back to a fuzzy picker.
    open)           cmd_worktree_open "${1:-}" ;;
    remove|rm)      cmd_worktree_remove "${1:-}" ;;
    nuke)           cmd_worktree_nuke "${1:-}" ;;
    docs)           dispatch_docs "$@" ;;
    help|-h|--help) cmd_help ;;
    *)              echo "Unknown command: $noun"; echo "Run 'jt help' for usage."; exit 1 ;;
esac
